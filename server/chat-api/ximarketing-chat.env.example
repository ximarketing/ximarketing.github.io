# Copy to /etc/ximarketing-chat.env, keep mode 600, and never commit the real file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
SITE_CONTEXT_URL=https://ximarketing.ai/chatbot-context.json
ALLOWED_ORIGINS=https://ximarketing.ai,https://www.ximarketing.ai
HOST=0.0.0.0
PORT=8787
CONTEXT_CACHE_SECONDS=600
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=600
DAILY_REQUEST_LIMIT=500
MAX_CONCURRENT_CHATS=4
MAX_CONNECTION_THREADS=16
