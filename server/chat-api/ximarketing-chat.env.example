# Copy to /etc/ximarketing-chat.env, keep mode 600, and never commit the real file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Xi Li Website <onboarding@resend.dev>
CONTACT_TO_EMAIL=xili@hku.hk
CONTACT_RATE_LIMIT_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
CONTACT_DAILY_LIMIT=50
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.18.0.0/16
SITE_CONTEXT_URL=https://ximarketing.ai/chatbot-context.json
ALLOWED_ORIGINS=https://ximarketing.ai,https://www.ximarketing.ai,http://127.0.0.1:4000,http://localhost:4000
HOST=0.0.0.0
PORT=8787
CONTEXT_CACHE_SECONDS=600
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=600
DAILY_REQUEST_LIMIT=500
MAX_CONCURRENT_CHATS=4
MAX_CONNECTION_THREADS=16
