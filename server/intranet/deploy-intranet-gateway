#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Run this updater with sudo." >&2
  exit 1
fi
if [[ $# -ne 1 ]]; then
  echo "Usage: sudo $0 /path/to/nginx.conf" >&2
  exit 1
fi

source_config=$(readlink -f -- "$1")
intranet_dir=/opt/ximarketing-intranet
live_config="$intranet_dir/nginx.conf"
compose_file="$intranet_dir/compose.yaml"
password_hash_file="$intranet_dir/secrets/password.hash"
gateway_container=ximarketing-intranet-gateway
portal_container=ximarketing-intranet-portal
game_container=negotiation-game-negotiation-game-1
caddy_container=negotiation-game-caddy-1
caddy_file=/opt/ximarketing-games/negotiation-game/Caddyfile
gateway_image='nginx:1.30.4-alpine3.24@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46'
backup=""
work=""
transaction_started=0
committed=0

[[ -f $source_config && ! -L $source_config ]] || {
  echo "The staged nginx configuration is missing or unsafe." >&2
  exit 1
}

mkdir -p /run/lock
exec 7>/run/lock/ximarketing-public-stack.lock
flock -x 7
exec 8>/run/lock/ximarketing-intranet.lock
flock -x 8

rollback() {
  status=$?
  if [[ $committed -eq 1 || $status -eq 0 ]]; then
    return
  fi
  trap - EXIT
  trap '' HUP INT TERM
  if [[ $transaction_started -eq 0 ]]; then
    [[ -z $work || ! -d $work ]] || rm -rf -- "$work"
    [[ -z $backup || ! -d $backup ]] || rm -rf -- "$backup"
    exit "$status"
  fi

  set +e
  rollback_ok=1
  echo "Gateway deployment failed; restoring the previous configuration." >&2
  cp --preserve=mode,ownership,timestamps "$backup/nginx.conf" "$live_config" || rollback_ok=0
  docker compose -f "$compose_file" up -d --no-deps --force-recreate \
    --wait --wait-timeout 60 intranet-gateway >/dev/null 2>&1 || rollback_ok=0
  docker exec "$caddy_container" caddy validate \
    --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 || rollback_ok=0
  docker exec "$caddy_container" caddy reload \
    --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 || rollback_ok=0
  cmp -s "$live_config" "$backup/nginx.conf" || rollback_ok=0
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$gateway_container" 2>/dev/null) == healthy ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.Id}}' "$portal_container" 2>/dev/null) == "$portal_id_before" ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.State.StartedAt}}' "$portal_container" 2>/dev/null) == "$portal_started_before" ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.Id}}' "$game_container" 2>/dev/null) == "$game_id_before" ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.State.StartedAt}}' "$game_container" 2>/dev/null) == "$game_started_before" ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$portal_container" 2>/dev/null) == healthy ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.State.Running}}' "$game_container" 2>/dev/null) == true ]] || rollback_ok=0
  [[ $(docker inspect -f '{{len .HostConfig.PortBindings}}' "$gateway_container" 2>/dev/null) == 0 ]] || rollback_ok=0
  [[ $(docker inspect --format \
    '{{ range .Mounts }}{{ if eq .Destination "/etc/nginx/nginx.conf" }}{{ .Source }}{{ end }}{{ end }}' \
    "$gateway_container" 2>/dev/null) == "$live_config" ]] || rollback_ok=0
  [[ $(sha256sum "$password_hash_file" 2>/dev/null | awk '{print $1}') == "$hash_digest_before" ]] || rollback_ok=0
  [[ $(sha256sum "$caddy_file" 2>/dev/null | awk '{print $1}') == "$caddy_digest_before" ]] || rollback_ok=0
  restored_status=$(curl -sS --max-time 12 -o /dev/null -w '%{http_code}' \
    https://intranet.ximarketing.ai/ 2>/dev/null || true)
  [[ $restored_status == 200 ]] || rollback_ok=0

  [[ -z $work || ! -d $work ]] || rm -rf -- "$work"
  if [[ $rollback_ok -eq 1 ]]; then
    echo "Rollback verified. Recovery files remain at $backup" >&2
  else
    echo "Automatic rollback could not be fully verified." >&2
    echo "Keep the recovery files at $backup for manual recovery." >&2
  fi
  exit "$status"
}
trap rollback EXIT
trap 'exit 130' HUP INT TERM

[[ -d $intranet_dir && ! -L $intranet_dir ]]
[[ $(stat -c '%u:%g %a' "$intranet_dir") == '0:0 700' ]]
[[ -f $live_config && ! -L $live_config ]]
[[ -f $compose_file && ! -L $compose_file ]]
[[ -f $password_hash_file && ! -L $password_hash_file ]]
[[ -f $caddy_file && ! -L $caddy_file ]]
[[ $(stat -c '%u:%g %a' "$live_config") == '0:101 640' ]]
[[ $(docker inspect -f '{{.State.Health.Status}}' "$gateway_container") == healthy ]]
[[ $(docker inspect -f '{{.State.Health.Status}}' "$portal_container") == healthy ]]
[[ $(docker inspect -f '{{.State.Running}}' "$game_container") == true ]]
[[ $(docker inspect -f '{{len .HostConfig.PortBindings}}' "$gateway_container") == 0 ]]
[[ $(docker inspect -f '{{len .HostConfig.PortBindings}}' "$portal_container") == 0 ]]
[[ $(docker inspect -f '{{len .HostConfig.PortBindings}}' "$game_container") == 0 ]]
[[ $(docker inspect --format \
  '{{ range .Mounts }}{{ if eq .Destination "/etc/nginx/nginx.conf" }}{{ .Source }}{{ end }}{{ end }}' \
  "$gateway_container") == "$live_config" ]]
docker compose -f "$compose_file" config --quiet
docker exec "$gateway_container" nginx -t >/dev/null

portal_id_before=$(docker inspect -f '{{.Id}}' "$portal_container")
portal_started_before=$(docker inspect -f '{{.State.StartedAt}}' "$portal_container")
game_id_before=$(docker inspect -f '{{.Id}}' "$game_container")
game_started_before=$(docker inspect -f '{{.State.StartedAt}}' "$game_container")
hash_digest_before=$(sha256sum "$password_hash_file" | awk '{print $1}')
caddy_digest_before=$(sha256sum "$caddy_file" | awk '{print $1}')

work=$(mktemp -d "$intranet_dir/.gateway-stage.XXXXXX")
chmod 0700 "$work"
install -o root -g 101 -m 0640 "$source_config" "$work/nginx.conf"

docker run --rm --network none --read-only --user 101:101 --cap-drop ALL \
  --tmpfs /var/cache/nginx:size=4m,mode=0700,uid=101,gid=101 \
  --tmpfs /var/run:size=1m,mode=0700,uid=101,gid=101 \
  --tmpfs /tmp:size=2m,mode=1777 \
  -v "$work/nginx.conf:/etc/nginx/nginx.conf:ro" \
  --entrypoint nginx "$gateway_image" -t >/dev/null

[[ -d $intranet_dir/backups && ! -L $intranet_dir/backups ]]
backup=$(mktemp -d "$intranet_dir/backups/gateway.XXXXXX")
chown root:root "$backup"
chmod 0700 "$backup"
cp -a "$live_config" "$backup/nginx.conf"

transaction_started=1
install -o root -g 101 -m 0640 "$work/nginx.conf" "$live_config"
cmp -s "$live_config" "$work/nginx.conf"
docker compose -f "$compose_file" up -d --no-deps --force-recreate \
  --wait --wait-timeout 60 intranet-gateway
[[ $(docker inspect -f '{{.State.Health.Status}}' "$gateway_container") == healthy ]]
docker exec "$caddy_container" caddy validate \
  --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null
docker exec "$caddy_container" caddy reload \
  --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null

headers="$work/response.headers"
status=$(curl -sS --max-time 12 -D "$headers" -o "$work/root.body" -w '%{http_code}' \
  https://intranet.ximarketing.ai/)
[[ $status == 200 ]]
tr -d '\r' < "$headers" | grep -Fqi 'x-xi-intranet-portal: password-form'

status=$(curl -sS --max-time 12 -D "$headers" -o /dev/null -w '%{http_code}' \
  https://intranet.ximarketing.ai/login.css)
[[ $status == 200 ]]
tr -d '\r' < "$headers" | grep -Eqi '^content-type: text/css; charset=utf-8$'

for script in intranet-bootstrap.js intranet.js; do
  status=$(curl -sS --max-time 12 -D "$headers" -o /dev/null -w '%{http_code}' \
    "https://intranet.ximarketing.ai/$script")
  [[ $status == 200 ]]
  tr -d '\r' < "$headers" | grep -Eqi '^content-type: application/javascript; charset=utf-8$'
done

for asset in login.css intranet-bootstrap.js intranet.js; do
  for _ in 1 2 3 4; do
    status=$(curl -sS --max-time 12 -o /dev/null -w '%{http_code}' \
      "https://intranet.ximarketing.ai/$asset")
    [[ $status == 200 ]]
  done
  status=$(curl -sS --max-time 12 -I -o /dev/null -w '%{http_code}' \
    "https://intranet.ximarketing.ai/$asset")
  [[ $status == 200 ]]
done

status=$(curl -sS --max-time 12 -D "$headers" -o /dev/null -w '%{http_code}' \
  https://intranet.ximarketing.ai/games/negotiation/)
[[ $status == 200 ]]
status=$(curl -sS --max-time 12 -D "$headers" -o /dev/null -w '%{http_code}' \
  -X POST https://intranet.ximarketing.ai/games/negotiation/api/rooms)
[[ $status == 403 ]]
status=$(curl -sS --max-time 12 -D "$headers" -o /dev/null -w '%{http_code}' \
  -X POST -H 'Origin: https://intranet.ximarketing.ai' \
  https://intranet.ximarketing.ai/games/negotiation/api/rooms)
[[ $status == 401 ]]

[[ $(docker inspect -f '{{.Id}}' "$portal_container") == "$portal_id_before" ]]
[[ $(docker inspect -f '{{.State.StartedAt}}' "$portal_container") == "$portal_started_before" ]]
[[ $(docker inspect -f '{{.Id}}' "$game_container") == "$game_id_before" ]]
[[ $(docker inspect -f '{{.State.StartedAt}}' "$game_container") == "$game_started_before" ]]
[[ $(sha256sum "$password_hash_file" | awk '{print $1}') == "$hash_digest_before" ]]
[[ $(sha256sum "$caddy_file" | awk '{print $1}') == "$caddy_digest_before" ]]
[[ $(docker inspect -f '{{.State.Health.Status}}' "$gateway_container") == healthy ]]
[[ $(docker inspect -f '{{.State.Health.Status}}' "$portal_container") == healthy ]]
[[ $(docker inspect -f '{{.State.Running}}' "$game_container") == true ]]
[[ $(docker inspect -f '{{len .HostConfig.PortBindings}}' "$gateway_container") == 0 ]]
[[ $(docker inspect --format \
  '{{ range .Mounts }}{{ if eq .Destination "/etc/nginx/nginx.conf" }}{{ .Source }}{{ end }}{{ end }}' \
  "$gateway_container") == "$live_config" ]]

committed=1
trap - EXIT INT TERM HUP
rm -rf -- "$work"
printf 'DEPLOYED\nBACKUP=%s\n' "$backup"
