#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Run this updater with sudo." >&2
  exit 1
fi
force=0
if [[ ${1:-} == --force ]]; then
  force=1
  shift
fi
if [[ $# -ne 1 || $force -ne 1 ]]; then
  echo "Usage: sudo $0 --force /path/to/staged-bundle" >&2
  echo "Updating this in-memory game clears an active A/B session." >&2
  exit 1
fi

stage_input=$(readlink -f -- "$1")
stage=$stage_input
intranet_dir=/opt/ximarketing-intranet
public_dir=/opt/ximarketing-games/negotiation-game
public_caddy="$public_dir/Caddyfile"
public_override="$public_dir/compose.override.yaml"
game_dir=/opt/ximarketing-games/ab-test-showdown
game_container=ximarketing-ab-test-showdown
game_network=ximarketing_ab_test_private
picker_container=ximarketing-classroom-picker
picker_network=ximarketing_classroom_picker_private
haggle_container=ximarketing-haggle-game
haggle_network=ximarketing_haggle_private
caddy_container=negotiation-game-caddy-1
negotiation_container=negotiation-game-negotiation-game-1
portal_container=ximarketing-intranet-portal
gateway_container=ximarketing-intranet-gateway
stamp=$(date -u +%Y%m%dT%H%M%SZ)
backup="$intranet_dir/backups/ab-test.$stamp"
work=""
snapshot=""
candidate=""
portal_profile=""
proxy_profile=""
feature_profile=""
candidate_image="ximarketing-ab-test-showdown:deploy-$stamp"
old_image_id=""
old_game_existed=0
network_created=0
caddy_connected=0
picker_active=0
picker_network_existed=0
picker_network_created=0
picker_caddy_connected=0
haggle_active=0
haggle_network_existed=0
haggle_network_created=0
haggle_caddy_connected=0
source_swapped=0
files_written=0
caddy_write_started=0
caddy_write_completed=0
transaction_started=0
committed=0
negotiation_id=""
negotiation_started=""
negotiation_restarts=""
picker_id=""
picker_image=""
picker_started=""
picker_restarts=""
picker_network_id=""
haggle_id=""
haggle_image=""
haggle_started=""
haggle_restarts=""
haggle_network_id=""
password_digest=""
legacy_nginx_digest=73dcbaef8d48e2c35e028972eac5a3125281fa100bfc09079817220b5c760b90
legacy_compose_digest=3f83b2ce93b18a3781959d517f7020b68f193ad283896a939e4ccb0c4489fe6f

required=(
  portal.py test_portal.py Caddyfile.proxy.example README.md
  intranet-feature-profile.sh
  nginx.conf compose.yaml compose.proxy.override.yaml
  game/Dockerfile game/.dockerignore game/compose.yaml
  game/package.json game/package-lock.json game/LICENSE game/server.js
  game/questions.js game/rounds.js game/test.js
  game/public/index.html game/public/host.html game/public/play.html
  game/public/style.css game/public/i18n.js
  game/public/vendor/qrcode.min.js game/public/vendor/qrcodejs-LICENSE.txt
)
validate_stage() {
  local relative path
  for relative in "${required[@]}"; do
    path="$stage/$relative"
    [[ -f $path && ! -L $path ]] || {
      echo "Missing or unsafe staged file: $path" >&2
      return 1
    }
  done
  if find "$stage" -type l -print -quit | grep -q .; then
    echo "The staged bundle must not contain symbolic links." >&2
    return 1
  fi
  if [[ -d $stage/game/node_modules ]]; then
    echo "Do not stage node_modules; the pinned image installs from package-lock.json." >&2
    return 1
  fi
  [[ $(find "$stage/game/public/images" -maxdepth 1 -type f -name 'ex*_v*.png' | wc -l) -eq 48 ]]
  [[ $(find "$stage/game/public/images" -maxdepth 1 -type f \( -name 'ex*_A*.png' -o -name 'ex*_B*.png' \) | wc -l) -eq 0 ]]
  if grep -R -a -E -q --exclude='package-lock.json' \
    'GAME_PIN|x-host-pin|wrong_pin|start password|启动密码' "$stage/game"; then
    echo "The staged game contains a retired password/PIN flow." >&2
    return 1
  fi
  grep -q 'buildRounds' "$stage/game/server.js"
  grep -q 'revealTimer' "$stage/game/server.js"
  grep -q 'randomInt' "$stage/game/rounds.js"
  grep -q 'winner: "v2"' "$stage/game/questions.js"
  ! grep -Fq 'correct: "B"' "$stage/game/questions.js"
  grep -Fq "const HOST_SOCKET_PATH = '/host-socket.io'" "$stage/game/server.js"
  grep -Fq "const HOST_AUTH_HEADER = 'x-ab-host-authenticated'" "$stage/game/server.js"
  grep -Fq "req.headers[HOST_AUTH_HEADER] === '1'" "$stage/game/server.js"
  grep -Fq "'/host-socket.io'" "$stage/game/public/host.html"
  ! grep -Fq 'href="play.html"' "$stage/game/public/index.html"
  grep -q "transports: \['websocket'\]" "$stage/game/public/host.html"
  grep -q "transports: \['websocket'\]" "$stage/game/public/play.html"
  ! grep -R -a -E -q 'https://(cdn|unpkg|jsdelivr)' "$stage/game/public"
}

validate_stage

mkdir -p /run/lock
exec 7>/run/lock/ximarketing-public-stack.lock
flock -x 7
exec 8>/run/lock/ximarketing-intranet.lock
flock -x 8

network_members() {
  docker network inspect --format \
    '{{ range .Containers }}{{ println .Name }}{{ end }}' "$1" 2>/dev/null | \
    sed '/^[[:space:]]*$/d' | LC_ALL=C sort
}

network_members_are() {
  local network=$1
  shift
  local actual expected
  actual=$(network_members "$network") || return 1
  expected=$(printf '%s\n' "$@" | sed '/^[[:space:]]*$/d' | LC_ALL=C sort)
  [[ $actual == "$expected" ]]
}

container_networks_are() {
  local container=$1
  shift
  local actual expected
  actual=$(docker inspect --format \
    '{{ range $name, $settings := .NetworkSettings.Networks }}{{ println $name }}{{ end }}' \
    "$container" 2>/dev/null | sed '/^[[:space:]]*$/d' | LC_ALL=C sort) || return 1
  expected=$(printf '%s\n' "$@" | sed '/^[[:space:]]*$/d' | LC_ALL=C sort)
  [[ $actual == "$expected" ]]
}

network_is_private_bridge() {
  [[ $(docker network inspect --format '{{.Driver}}|{{.Internal}}|{{.Scope}}' \
    "$1" 2>/dev/null) == 'bridge|true|local' ]]
}

network_is_egress_bridge() {
  [[ $(docker network inspect --format '{{.Driver}}|{{.Internal}}|{{.Scope}}' \
    "$1" 2>/dev/null) == 'bridge|false|local' ]]
}

rollback() {
  status=$?
  if [[ $committed -eq 1 || $status -eq 0 ]]; then
    return
  fi
  trap - EXIT INT TERM HUP
  if [[ $transaction_started -eq 0 ]]; then
    [[ -n $work && -d $work ]] && rm -rf -- "$work"
    exit "$status"
  fi

  set +e
  rollback_ok=1
  echo "A/B game deployment failed; restoring the prior private portal." >&2

  if [[ $caddy_write_started -eq 1 ]]; then
    if [[ $caddy_write_completed -eq 0 ]] || cmp -s "$public_caddy" "$candidate"; then
      cp "$backup/Caddyfile" "$public_caddy" || rollback_ok=0
      chown ubuntu:ubuntu "$public_caddy" || rollback_ok=0
      chmod 0644 "$public_caddy" || rollback_ok=0
      docker exec "$caddy_container" caddy validate \
        --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 || rollback_ok=0
      docker exec "$caddy_container" caddy reload \
        --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 || rollback_ok=0
    elif ! cmp -s "$public_caddy" "$backup/Caddyfile"; then
      echo "The public Caddyfile changed outside this transaction; it was not overwritten." >&2
      rollback_ok=0
    fi
  fi

  docker rm -f "$game_container" >/dev/null 2>&1 || true
  if [[ $source_swapped -eq 1 ]]; then
    rm -rf -- "$game_dir"
    if [[ $old_game_existed -eq 1 && -d $backup/game ]]; then
      cp -a "$backup/game" "$game_dir" || rollback_ok=0
    fi
  fi
  if [[ $old_game_existed -eq 1 && -n $old_image_id && -d $game_dir ]]; then
    docker tag "$old_image_id" ximarketing-ab-test-showdown:latest || rollback_ok=0
    docker compose -f "$game_dir/compose.yaml" \
      up -d --no-build --force-recreate --wait --wait-timeout 60 \
      ab-test-showdown >/dev/null 2>&1 || rollback_ok=0
  fi

  if [[ $files_written -eq 1 ]]; then
    cp "$backup/portal.py" "$intranet_dir/portal.py" || rollback_ok=0
    chown root:65534 "$intranet_dir/portal.py" || rollback_ok=0
    chmod 0640 "$intranet_dir/portal.py" || rollback_ok=0
    cp "$backup/README.md" "$intranet_dir/README.md" || rollback_ok=0
    chown root:root "$intranet_dir/README.md" || rollback_ok=0
    chmod 0600 "$intranet_dir/README.md" || rollback_ok=0
    cp "$backup/nginx.conf" "$intranet_dir/nginx.conf" || rollback_ok=0
    chown root:101 "$intranet_dir/nginx.conf" || rollback_ok=0
    chmod 0640 "$intranet_dir/nginx.conf" || rollback_ok=0
    cp "$backup/compose.yaml" "$intranet_dir/compose.yaml" || rollback_ok=0
    chown root:root "$intranet_dir/compose.yaml" || rollback_ok=0
    chmod 0600 "$intranet_dir/compose.yaml" || rollback_ok=0
    cp "$backup/compose.override.yaml" "$public_override" || rollback_ok=0
    chown root:root "$public_override" || rollback_ok=0
    chmod 0644 "$public_override" || rollback_ok=0
    docker compose -f "$intranet_dir/compose.yaml" \
      up -d --force-recreate --wait --wait-timeout 60 \
      intranet-portal intranet-gateway >/dev/null 2>&1 || rollback_ok=0
  fi

  if [[ $old_game_existed -eq 0 ]]; then
    if [[ $caddy_connected -eq 1 ]]; then
      docker network disconnect "$game_network" "$caddy_container" \
        >/dev/null 2>&1 || rollback_ok=0
    fi
    if [[ $network_created -eq 1 ]]; then
      docker network rm "$game_network" >/dev/null 2>&1 || rollback_ok=0
    fi
  fi

  if [[ $picker_caddy_connected -eq 1 ]]; then
    docker network disconnect "$picker_network" "$caddy_container" \
      >/dev/null 2>&1 || rollback_ok=0
  fi
  if [[ $picker_network_created -eq 1 ]]; then
    docker network rm "$picker_network" >/dev/null 2>&1 || rollback_ok=0
  fi
  if [[ $haggle_caddy_connected -eq 1 ]]; then
    docker network disconnect "$haggle_network" "$caddy_container" \
      >/dev/null 2>&1 || rollback_ok=0
  fi
  if [[ $haggle_network_created -eq 1 ]]; then
    docker network rm "$haggle_network" >/dev/null 2>&1 || rollback_ok=0
  fi

  [[ $(docker inspect -f '{{.Id}}' "$negotiation_container" 2>/dev/null) == \
    "$negotiation_id" ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.State.StartedAt}}' "$negotiation_container" 2>/dev/null) == \
    "$negotiation_started" ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.RestartCount}}' "$negotiation_container" 2>/dev/null) == \
    "$negotiation_restarts" ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$portal_container" 2>/dev/null) == \
    healthy ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$gateway_container" 2>/dev/null) == \
    healthy ]] || rollback_ok=0
  [[ $(sha256sum "$intranet_dir/secrets/password.hash" 2>/dev/null | awk '{print $1}') == \
    "$password_digest" ]] || rollback_ok=0
  if [[ $picker_active -eq 1 ]]; then
    [[ $(docker inspect -f '{{.Id}}' "$picker_container" 2>/dev/null) == \
      "$picker_id" ]] || rollback_ok=0
    [[ $(docker inspect -f '{{.Image}}' "$picker_container" 2>/dev/null) == \
      "$picker_image" ]] || rollback_ok=0
    [[ $(docker inspect -f '{{.State.StartedAt}}' "$picker_container" 2>/dev/null) == \
      "$picker_started" ]] || rollback_ok=0
    [[ $(docker inspect -f '{{.RestartCount}}' "$picker_container" 2>/dev/null) == \
      "$picker_restarts" ]] || rollback_ok=0
    [[ $(docker network inspect -f '{{.Id}}' "$picker_network" 2>/dev/null) == \
      "$picker_network_id" ]] || rollback_ok=0
    network_members_are "$picker_network" "$caddy_container" "$picker_container" || rollback_ok=0
    container_networks_are "$picker_container" "$picker_network" || rollback_ok=0
  else
    ! docker container inspect "$picker_container" >/dev/null 2>&1 || rollback_ok=0
    if [[ $picker_network_existed -eq 1 ]]; then
      [[ $(docker network inspect -f '{{.Id}}' "$picker_network" 2>/dev/null) == \
        "$picker_network_id" ]] || rollback_ok=0
      network_members_are "$picker_network" "$caddy_container" || rollback_ok=0
    else
      ! docker network inspect "$picker_network" >/dev/null 2>&1 || rollback_ok=0
    fi
  fi
  if [[ $haggle_active -eq 1 ]]; then
    [[ $(docker inspect -f '{{.Id}}' "$haggle_container" 2>/dev/null) == \
      "$haggle_id" ]] || rollback_ok=0
    [[ $(docker inspect -f '{{.Image}}' "$haggle_container" 2>/dev/null) == \
      "$haggle_image" ]] || rollback_ok=0
    [[ $(docker inspect -f '{{.State.StartedAt}}' "$haggle_container" 2>/dev/null) == \
      "$haggle_started" ]] || rollback_ok=0
    [[ $(docker inspect -f '{{.RestartCount}}' "$haggle_container" 2>/dev/null) == \
      "$haggle_restarts" ]] || rollback_ok=0
    [[ $(docker network inspect -f '{{.Id}}' "$haggle_network" 2>/dev/null) == \
      "$haggle_network_id" ]] || rollback_ok=0
    network_members_are "$haggle_network" "$caddy_container" "$haggle_container" || rollback_ok=0
    container_networks_are "$haggle_container" "$haggle_network" || rollback_ok=0
  else
    ! docker container inspect "$haggle_container" >/dev/null 2>&1 || rollback_ok=0
    if [[ $haggle_network_existed -eq 1 ]]; then
      [[ $(docker network inspect -f '{{.Id}}' "$haggle_network" 2>/dev/null) == \
        "$haggle_network_id" ]] || rollback_ok=0
      network_members_are "$haggle_network" "$caddy_container" || rollback_ok=0
    else
      ! docker network inspect "$haggle_network" >/dev/null 2>&1 || rollback_ok=0
    fi
  fi

  if [[ $rollback_ok -eq 1 ]]; then
    echo "Rollback verified. Recovery files remain at $backup" >&2
  else
    echo "Automatic rollback could not be fully verified. Keep $backup" >&2
  fi
  exit "$status"
}
trap rollback EXIT
trap 'exit 130' HUP INT TERM

# From this point on, use only a root-owned snapshot. The caller may own the
# original staging directory, so no validated file is reread from it later.
work=$(mktemp -d "$intranet_dir/.ab-test-stage.XXXXXX")
chmod 0700 "$work"
install -d -o root -g root -m 0700 "$work/stage"
cp -a "$stage_input/." "$work/stage/"
chown -R root:root "$work/stage"
find "$work/stage" -type d -exec chmod 0700 {} +
find "$work/stage" -type f -exec chmod 0600 {} +
stage="$work/stage"
validate_stage
source "$stage/intranet-feature-profile.sh"
intranet_ab_markers_are_full "$stage/portal.py"
intranet_ab_markers_are_full "$stage/Caddyfile.proxy.example"
intranet_picker_markers_are_full "$stage/portal.py"
intranet_picker_markers_are_full "$stage/Caddyfile.proxy.example"
intranet_haggle_markers_are_full "$stage/portal.py"
intranet_haggle_markers_are_full "$stage/Caddyfile.proxy.example"

portal_profile="$work/portal.profile.py"
proxy_profile="$work/Caddyfile.proxy.profile"

[[ -d $intranet_dir && ! -L $intranet_dir ]]
[[ -f $public_caddy && ! -L $public_caddy ]]
[[ -f $public_override && ! -L $public_override ]]
[[ -f $intranet_dir/portal.py && ! -L $intranet_dir/portal.py ]]
[[ -f $intranet_dir/README.md && ! -L $intranet_dir/README.md ]]
[[ -f $intranet_dir/nginx.conf && ! -L $intranet_dir/nginx.conf ]]
[[ -f $intranet_dir/compose.yaml && ! -L $intranet_dir/compose.yaml ]]
if ! cmp -s "$stage/nginx.conf" "$intranet_dir/nginx.conf"; then
  [[ $(sha256sum "$intranet_dir/nginx.conf" | awk '{print $1}') == \
    "$legacy_nginx_digest" ]]
fi
if ! cmp -s "$stage/compose.yaml" "$intranet_dir/compose.yaml"; then
  [[ $(sha256sum "$intranet_dir/compose.yaml" | awk '{print $1}') == \
    "$legacy_compose_digest" ]]
fi
grep -Eq '^\$2[aby]\$12\$[./A-Za-z0-9]{53}$' \
  "$intranet_dir/secrets/password.hash"

snapshot="$work/Caddyfile.base"
candidate="$work/Caddyfile.candidate"
cp "$public_caddy" "$snapshot"

cat > "$work/compose.override.expected.yaml" <<'EOF'
services:
  caddy:
    networks:
      default: {}
      intranet_edge: {}
      ab_test_private: {}
      classroom_picker_private: {}
      haggle_private: {}

networks:
  intranet_edge:
    external: true
    name: ximarketing_intranet_edge
  ab_test_private:
    external: true
    name: ximarketing_ab_test_private
  classroom_picker_private:
    external: true
    name: ximarketing_classroom_picker_private
  haggle_private:
    external: true
    name: ximarketing_haggle_private
EOF
cmp -s "$work/compose.override.expected.yaml" "$stage/compose.proxy.override.yaml" || {
  echo "The staged public Compose override does not include every dedicated private network." >&2
  exit 1
}

if ! cmp -s "$stage/compose.proxy.override.yaml" "$public_override"; then
  cat > "$work/compose.override.legacy-base.yaml" <<'EOF'
services:
  caddy:
    networks:
      default: {}
      intranet_edge: {}

networks:
  intranet_edge:
    external: true
    name: ximarketing_intranet_edge
EOF
  cat > "$work/compose.override.legacy-ab.yaml" <<'EOF'
services:
  caddy:
    networks:
      default: {}
      intranet_edge: {}
      ab_test_private: {}

networks:
  intranet_edge:
    external: true
    name: ximarketing_intranet_edge
  ab_test_private:
    external: true
    name: ximarketing_ab_test_private
EOF
  cat > "$work/compose.override.legacy-full.yaml" <<'EOF'
services:
  caddy:
    networks:
      default: {}
      intranet_edge: {}
      ab_test_private: {}
      classroom_picker_private: {}

networks:
  intranet_edge:
    external: true
    name: ximarketing_intranet_edge
  ab_test_private:
    external: true
    name: ximarketing_ab_test_private
  classroom_picker_private:
    external: true
    name: ximarketing_classroom_picker_private
EOF
  if ! cmp -s "$work/compose.override.legacy-base.yaml" "$public_override" && \
     ! cmp -s "$work/compose.override.legacy-ab.yaml" "$public_override" && \
     ! cmp -s "$work/compose.override.legacy-full.yaml" "$public_override"; then
    echo "The public Compose override has unmanaged changes." >&2
    exit 1
  fi
fi

if intranet_picker_markers_are_full "$intranet_dir/portal.py" && \
   intranet_picker_markers_are_full "$public_caddy"; then
  picker_active=1
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$picker_container") == healthy ]]
  [[ $(docker inspect -f '{{len .HostConfig.PortBindings}}' "$picker_container") == 0 ]]
  container_networks_are "$picker_container" "$picker_network"
  network_is_private_bridge "$picker_network"
  network_members_are "$picker_network" "$caddy_container" "$picker_container"
  picker_network_existed=1
  picker_network_id=$(docker network inspect -f '{{.Id}}' "$picker_network")
  picker_id=$(docker inspect -f '{{.Id}}' "$picker_container")
  picker_image=$(docker inspect -f '{{.Image}}' "$picker_container")
  picker_started=$(docker inspect -f '{{.State.StartedAt}}' "$picker_container")
  picker_restarts=$(docker inspect -f '{{.RestartCount}}' "$picker_container")
elif intranet_picker_markers_are_absent "$intranet_dir/portal.py" && \
     intranet_picker_markers_are_absent "$public_caddy"; then
  ! docker container inspect "$picker_container" >/dev/null 2>&1
  if docker network inspect "$picker_network" >/dev/null 2>&1; then
    picker_network_existed=1
    network_is_private_bridge "$picker_network"
    network_members_are "$picker_network" "$caddy_container"
    picker_network_id=$(docker network inspect -f '{{.Id}}' "$picker_network")
  fi
else
  echo "The installed Classroom Picker feature state is inconsistent; refusing the A/B update." >&2
  exit 1
fi
if intranet_haggle_markers_are_full "$intranet_dir/portal.py" && \
   intranet_haggle_markers_are_full "$public_caddy"; then
  haggle_active=1
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$haggle_container") == healthy ]]
  [[ $(docker inspect -f '{{len .HostConfig.PortBindings}}' "$haggle_container") == 0 ]]
  container_networks_are "$haggle_container" "$haggle_network"
  network_is_egress_bridge "$haggle_network"
  network_members_are "$haggle_network" "$caddy_container" "$haggle_container"
  haggle_network_existed=1
  haggle_network_id=$(docker network inspect -f '{{.Id}}' "$haggle_network")
  haggle_id=$(docker inspect -f '{{.Id}}' "$haggle_container")
  haggle_image=$(docker inspect -f '{{.Image}}' "$haggle_container")
  haggle_started=$(docker inspect -f '{{.State.StartedAt}}' "$haggle_container")
  haggle_restarts=$(docker inspect -f '{{.RestartCount}}' "$haggle_container")
elif intranet_haggle_markers_are_absent "$intranet_dir/portal.py" && \
     intranet_haggle_markers_are_absent "$public_caddy"; then
  ! docker container inspect "$haggle_container" >/dev/null 2>&1
  if docker network inspect "$haggle_network" >/dev/null 2>&1; then
    haggle_network_existed=1
    network_is_egress_bridge "$haggle_network"
    network_members_are "$haggle_network" "$caddy_container"
    haggle_network_id=$(docker network inspect -f '{{.Id}}' "$haggle_network")
  fi
else
  echo "The installed Haggle feature state is inconsistent; refusing the A/B update." >&2
  exit 1
fi

feature_profile=$(intranet_profile_for_features 1 "$picker_active" "$haggle_active")
render_intranet_feature_profile "$feature_profile" \
  "$stage/portal.py" "$stage/Caddyfile.proxy.example" \
  "$portal_profile" "$proxy_profile"
intranet_ab_markers_are_full "$portal_profile"
intranet_ab_markers_are_full "$proxy_profile"
if [[ $picker_active -eq 1 ]]; then
  intranet_picker_markers_are_full "$portal_profile"
  intranet_picker_markers_are_full "$proxy_profile"
else
  intranet_picker_markers_are_absent "$portal_profile"
  intranet_picker_markers_are_absent "$proxy_profile"
fi
if [[ $haggle_active -eq 1 ]]; then
  intranet_haggle_markers_are_full "$portal_profile"
  intranet_haggle_markers_are_full "$proxy_profile"
