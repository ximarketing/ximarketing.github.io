#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Run this updater with sudo." >&2
  exit 1
fi
force=0
if [[ ${1:-} == --force ]]; then
  force=1
  shift
fi
if [[ $# -ne 1 || $force -ne 1 ]]; then
  echo "Usage: sudo $0 --force /path/to/staged-bundle" >&2
  echo "Updating Classroom Picker clears its in-memory class session." >&2
  exit 1
fi

stage_argument=$1
[[ -d $stage_argument && ! -L $stage_argument ]] || {
  echo "The staged bundle must be a real directory, not a symbolic link." >&2
  exit 1
}
stage_input=$(readlink -f -- "$stage_argument")
case "$stage_input" in
  /|/etc|/home|/opt|/root|/tmp|/usr|/var)
    echo "Refusing a broad system directory as the staged bundle." >&2
    exit 1
    ;;
esac
stage_megabytes=$(du -sm -- "$stage_input" | awk '{print $1}')
stage_entries=$(find "$stage_input" -xdev -mindepth 1 -print | wc -l)
if (( stage_megabytes > 64 || stage_entries > 2000 )); then
  echo "The staged bundle is unexpectedly large; refusing to copy it as root." >&2
  exit 1
fi
