validate_stage() {
  local relative path docker_from
  [[ -d $stage && ! -L $stage ]] || {
    echo "The root-owned staged snapshot is not a safe directory." >&2
    return 1
  }
  for relative in "${required[@]}"; do
    path="$stage/$relative"
    [[ -f $path && ! -L $path ]] || {
      echo "Missing or unsafe staged file: $path" >&2
      return 1
    }
  done
  if find "$stage" -type l -print -quit | grep -q .; then
    echo "The staged bundle must not contain symbolic links." >&2
    return 1
  fi
  if find "$stage" -mindepth 1 ! -type d ! -type f -print -quit | grep -q .; then
    echo "The staged bundle may contain only regular files and directories." >&2
    return 1
  fi
  if [[ -d $stage/tool/node_modules || -d $stage/tool/dist || -d $stage/tool/.git ]]; then
    echo "Do not stage node_modules, dist, or Git metadata for Classroom Picker." >&2
    return 1
  fi
  if find "$stage/tool" -type f \( -name '.env' -o -name '.env.*' \) -print -quit | grep -q .; then
    echo "The Classroom Picker bundle must not contain environment-secret files." >&2
    return 1
  fi
  if grep -R -a -E -q --exclude='package-lock.json' \
    'HOST_TOKEN|HKU2026|x-host-pin|hostPassword|api\.qrserver\.com|fonts\.googleapis\.com|fonts\.gstatic\.com' \
    "$stage/tool"; then
    echo "The staged tool contains a retired password flow or an external runtime dependency." >&2
    return 1
  fi
  if grep -R -a -E -q "type[[:space:]]*=[[:space:]]*['\"]password" \
    "$stage/tool/client"; then
    echo "The staged tool still contains a password input." >&2
    return 1
  fi
  grep -Fq '"name": "ximarketing-classroom-picker"' "$stage/tool/package.json"
  grep -Fq 'randomBytes(32)' "$stage/tool/server/routes.ts"
  grep -Fq '/api/host/claim' "$stage/tool/server/routes.ts"
  grep -Fq 'x-host-capability' "$stage/tool/server/routes.ts"
  grep -Fq 'x-participant-id' "$stage/tool/server/routes.ts"
  grep -Fq 'Object.hasOwn(initial.body, "participants"), false' \
    "$stage/tool/test/integration.test.mjs"
  grep -Fq 'RUN npm run check && npm test' "$stage/tool/Dockerfile"
  grep -Fxq 'node_modules' "$stage/tool/.dockerignore"
  grep -Fxq 'dist' "$stage/tool/.dockerignore"
  [[ $(grep -c '^FROM ' "$stage/tool/Dockerfile") -eq 2 ]]
  docker_from=$(grep '^FROM ' "$stage/tool/Dockerfile" | sed 's/ AS .*//')
  [[ $docker_from == $'FROM '"$node_image"$'\nFROM '"$node_image" ]]
  grep -Fq 'name: ximarketing_classroom_picker_private' "$stage/tool/compose.yaml"
  grep -Fq 'container_name: ximarketing-classroom-picker' "$stage/tool/compose.yaml"
  grep -Fq 'PUBLIC_ORIGIN: https://intranet.ximarketing.ai' "$stage/tool/compose.yaml"
  ! grep -Eq '^[[:space:]]*ports:' "$stage/tool/compose.yaml"
}

network_members() {
  docker network inspect --format \
    '{{ range .Containers }}{{ println .Name }}{{ end }}' "$1" 2>/dev/null | \
    sed '/^[[:space:]]*$/d' | LC_ALL=C sort
}

network_members_are() {
  local network=$1
  shift
  local actual expected
  actual=$(network_members "$network") || return 1
  expected=$(printf '%s\n' "$@" | sed '/^[[:space:]]*$/d' | LC_ALL=C sort)
  [[ $actual == "$expected" ]]
}

container_networks_are() {
  local container=$1
  shift
  local actual expected
  actual=$(docker inspect --format \
    '{{ range $name, $settings := .NetworkSettings.Networks }}{{ println $name }}{{ end }}' \
    "$container" 2>/dev/null | sed '/^[[:space:]]*$/d' | LC_ALL=C sort) || return 1
  expected=$(printf '%s\n' "$@" | sed '/^[[:space:]]*$/d' | LC_ALL=C sort)
  [[ $actual == "$expected" ]]
}

network_is_private_bridge() {
  [[ $(docker network inspect --format '{{.Driver}}|{{.Internal}}|{{.Scope}}' \
    "$1" 2>/dev/null) == 'bridge|true|local' ]]
}

tree_digest() {
  local root=$1
  tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 \
    --numeric-owner -C "$root" -cf - . | sha256sum | awk '{print $1}'
}

verify_preserved_services() {
  [[ $(docker inspect -f '{{.State.Running}}' "$negotiation_container" 2>/dev/null) == \
    true ]]
  [[ $(docker inspect -f '{{.Id}}' "$negotiation_container" 2>/dev/null) == \
    "$negotiation_id" ]]
  [[ $(docker inspect -f '{{.Image}}' "$negotiation_container" 2>/dev/null) == \
    "$negotiation_image" ]]
  [[ $(docker inspect -f '{{.State.StartedAt}}' "$negotiation_container" 2>/dev/null) == \
    "$negotiation_started" ]]
  [[ $(docker inspect -f '{{.RestartCount}}' "$negotiation_container" 2>/dev/null) == \
    "$negotiation_restarts" ]]
  [[ $(docker inspect -f '{{json .NetworkSettings.Networks}}' \
    "$negotiation_container" 2>/dev/null) == "$negotiation_networks" ]]

  if [[ $ab_active -eq 1 ]]; then
    [[ $(docker inspect -f '{{.State.Health.Status}}' "$ab_container" 2>/dev/null) == \
      healthy ]]
    [[ $(docker inspect -f '{{.Id}}' "$ab_container" 2>/dev/null) == "$ab_id" ]]
    [[ $(docker inspect -f '{{.Image}}' "$ab_container" 2>/dev/null) == "$ab_image" ]]
    [[ $(docker inspect -f '{{.State.StartedAt}}' "$ab_container" 2>/dev/null) == \
      "$ab_started" ]]
    [[ $(docker inspect -f '{{.RestartCount}}' "$ab_container" 2>/dev/null) == \
      "$ab_restarts" ]]
    [[ $(docker inspect -f '{{json .NetworkSettings.Networks}}' \
      "$ab_container" 2>/dev/null) == "$ab_networks" ]]
    [[ $(docker network inspect -f '{{.Id}}' "$ab_network" 2>/dev/null) == \
      "$ab_network_id" ]]
    network_members_are "$ab_network" "$caddy_container" "$ab_container"
    container_networks_are "$ab_container" "$ab_network"
  else
    ! docker container inspect "$ab_container" >/dev/null 2>&1
    if [[ $ab_network_existed -eq 1 ]]; then
      [[ $(docker network inspect -f '{{.Id}}' "$ab_network" 2>/dev/null) == \
        "$ab_network_id" ]]
      network_members_are "$ab_network" "$caddy_container"
    elif docker network inspect "$ab_network" >/dev/null 2>&1; then
      network_members_are "$ab_network" "$caddy_container"
    fi
  fi
}

rollback() {
  local status=$?
  if [[ $committed -eq 1 || $status -eq 0 ]]; then
    return
  fi
  trap - EXIT INT TERM HUP
  set +e

  if [[ $transaction_started -eq 0 ]]; then
    [[ $image_built -eq 1 ]] && docker image rm "$candidate_image" >/dev/null 2>&1
    [[ $backup_created -eq 1 && -d $backup ]] && rm -rf -- "$backup"
    [[ -n $work && -d $work ]] && rm -rf -- "$work"
    exit "$status"
  fi

  rollback_ok=1
  echo "Classroom Picker deployment failed; restoring the prior private portal." >&2

  if [[ $tool_container_replaced -eq 1 ]]; then
    docker rm -f "$tool_container" >/dev/null 2>&1 || true
  fi
  if [[ $source_swapped -eq 1 ]]; then
    [[ $tool_dir == /opt/ximarketing-tools/classroom-picker ]] || rollback_ok=0
    rm -rf -- "$tool_dir" || rollback_ok=0
    if [[ $old_tool_existed -eq 1 && -d $backup/tool ]]; then
      cp -a "$backup/tool" "$tool_dir" || rollback_ok=0
    fi
  fi
  if [[ -n $new_tool && $new_tool == "$tool_root"/.classroom-picker.new-* && \
        -e $new_tool ]]; then
    rm -rf -- "$new_tool" || rollback_ok=0
  fi
  if [[ $tool_container_replaced -eq 1 && $tool_old_active -eq 1 && \
        -n $old_image_id && -d $tool_dir ]]; then
    docker tag "$old_image_id" ximarketing-classroom-picker:latest || rollback_ok=0
    docker compose -f "$tool_dir/compose.yaml" \
      up -d --no-build --force-recreate --wait --wait-timeout 60 \
      classroom-picker >/dev/null 2>&1 || rollback_ok=0
  fi
  if [[ $latest_tag_changed -eq 1 ]]; then
    if [[ -n $old_latest_image_id ]]; then
      docker tag "$old_latest_image_id" ximarketing-classroom-picker:latest || rollback_ok=0
    elif docker image inspect ximarketing-classroom-picker:latest >/dev/null 2>&1; then
      docker image rm ximarketing-classroom-picker:latest >/dev/null 2>&1 || rollback_ok=0
    fi
  fi

  if [[ $files_written -eq 1 ]]; then
    cp "$backup/portal.py" "$intranet_dir/portal.py" || rollback_ok=0
    chown root:65534 "$intranet_dir/portal.py" || rollback_ok=0
    chmod 0640 "$intranet_dir/portal.py" || rollback_ok=0
    cp "$backup/README.md" "$intranet_dir/README.md" || rollback_ok=0
    chown root:root "$intranet_dir/README.md" || rollback_ok=0
    chmod 0600 "$intranet_dir/README.md" || rollback_ok=0
    cp "$backup/nginx.conf" "$intranet_dir/nginx.conf" || rollback_ok=0
    chown root:101 "$intranet_dir/nginx.conf" || rollback_ok=0
    chmod 0640 "$intranet_dir/nginx.conf" || rollback_ok=0
    cp "$backup/compose.yaml" "$intranet_dir/compose.yaml" || rollback_ok=0
    chown root:root "$intranet_dir/compose.yaml" || rollback_ok=0
    chmod 0600 "$intranet_dir/compose.yaml" || rollback_ok=0
    cp "$backup/compose.override.yaml" "$public_override" || rollback_ok=0
    chown root:root "$public_override" || rollback_ok=0
    chmod 0644 "$public_override" || rollback_ok=0
    docker compose -f "$intranet_dir/compose.yaml" \
      up -d --force-recreate --wait --wait-timeout 60 \
      intranet-portal intranet-gateway >/dev/null 2>&1 || rollback_ok=0
  fi

  if [[ $caddy_write_started -eq 1 ]]; then
    if [[ $caddy_write_completed -eq 0 ]] || cmp -s "$public_caddy" "$candidate"; then
      cp "$backup/Caddyfile" "$public_caddy" || rollback_ok=0
      chown ubuntu:ubuntu "$public_caddy" || rollback_ok=0
      chmod 0644 "$public_caddy" || rollback_ok=0
      docker exec "$caddy_container" caddy validate \
        --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 || rollback_ok=0
      docker exec "$caddy_container" caddy reload \
        --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 || rollback_ok=0
    elif ! cmp -s "$public_caddy" "$backup/Caddyfile"; then
      echo "The public Caddyfile changed outside this transaction; it was not overwritten." >&2
      rollback_ok=0
    fi
  fi

  if [[ $tool_old_active -eq 0 ]]; then
    if [[ $tool_caddy_connected -eq 1 ]]; then
      docker network disconnect "$tool_network" "$caddy_container" \
        >/dev/null 2>&1 || rollback_ok=0
    fi
    if [[ $tool_network_created -eq 1 ]]; then
      docker network rm "$tool_network" >/dev/null 2>&1 || rollback_ok=0
    fi
  fi
  if [[ $ab_caddy_connected -eq 1 ]]; then
    docker network disconnect "$ab_network" "$caddy_container" \
      >/dev/null 2>&1 || rollback_ok=0
  fi
  if [[ $ab_network_created -eq 1 ]]; then
    docker network rm "$ab_network" >/dev/null 2>&1 || rollback_ok=0
  fi
  if [[ $tool_root_created -eq 1 && -d $tool_root ]]; then
    rmdir "$tool_root" >/dev/null 2>&1 || true
  fi

  verify_preserved_services || rollback_ok=0
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$portal_container" 2>/dev/null) == \
    healthy ]] || rollback_ok=0
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$gateway_container" 2>/dev/null) == \
    healthy ]] || rollback_ok=0
  [[ $(sha256sum "$intranet_dir/secrets/password.hash" 2>/dev/null | awk '{print $1}') == \
    "$password_digest" ]] || rollback_ok=0

  if [[ $tool_old_active -eq 1 ]]; then
    [[ $(docker inspect -f '{{.State.Health.Status}}' "$tool_container" 2>/dev/null) == \
      healthy ]] || rollback_ok=0
    [[ $(docker inspect -f '{{.Image}}' "$tool_container" 2>/dev/null) == \
      "$old_image_id" ]] || rollback_ok=0
    [[ $(docker network inspect -f '{{.Id}}' "$tool_network" 2>/dev/null) == \
      "$tool_old_network_id" ]] || rollback_ok=0
    network_is_private_bridge "$tool_network" || rollback_ok=0
    network_members_are "$tool_network" "$caddy_container" "$tool_container" || rollback_ok=0
    container_networks_are "$tool_container" "$tool_network" || rollback_ok=0
  else
    ! docker container inspect "$tool_container" >/dev/null 2>&1 || rollback_ok=0
    if [[ $tool_network_existed -eq 1 ]]; then
      [[ $(docker network inspect -f '{{.Id}}' "$tool_network" 2>/dev/null) == \
        "$tool_old_network_id" ]] || rollback_ok=0
      network_members_are "$tool_network" "$caddy_container" || rollback_ok=0
    else
      ! docker network inspect "$tool_network" >/dev/null 2>&1 || rollback_ok=0
    fi
  fi

  if [[ $rollback_ok -eq 1 ]]; then
    echo "Rollback verified. Recovery files remain at $backup" >&2
  else
    echo "Automatic rollback could not be fully verified. Keep $backup" >&2
  fi
  [[ $image_built -eq 1 ]] && docker image rm "$candidate_image" >/dev/null 2>&1
  [[ -n $work && -d $work ]] && rm -rf -- "$work"
  exit "$status"
}

mkdir -p /run/lock
exec 7>/run/lock/ximarketing-public-stack.lock
flock -x 7
exec 8>/run/lock/ximarketing-intranet.lock
flock -x 8

trap rollback EXIT
trap 'exit 130' HUP INT TERM

[[ -d $intranet_dir && ! -L $intranet_dir ]] || {
  echo "The canonical intranet directory was not found." >&2
  exit 1
}
[[ $(stat -c '%u:%g %a' "$intranet_dir") == '0:0 700' ]] || {
  echo "The intranet directory has unexpected ownership or permissions." >&2
  exit 1
}

# No caller-owned file is inspected after this point. Copy first, then validate
# only the root-owned, mode-restricted snapshot while both stack locks are held.
work=$(mktemp -d "$intranet_dir/.classroom-picker-stage.XXXXXX")
chmod 0700 "$work"
install -d -o root -g root -m 0700 "$work/stage"
cp -a "$stage_input/." "$work/stage/"
chown -R root:root "$work/stage"
find "$work/stage" -type d -exec chmod 0700 {} +
find "$work/stage" -type f -exec chmod 0600 {} +
stage="$work/stage"
snapshot_megabytes=$(du -sm -- "$stage" | awk '{print $1}')
snapshot_entries=$(find "$stage" -xdev -mindepth 1 -print | wc -l)
if (( snapshot_megabytes > 64 || snapshot_entries > 2000 )); then
  echo "The root-owned staged snapshot is unexpectedly large." >&2
  exit 1
fi
validate_stage
source "$stage/intranet-feature-profile.sh"
intranet_ab_markers_are_full "$stage/portal.py"
intranet_ab_markers_are_full "$stage/Caddyfile.proxy.example"
intranet_picker_markers_are_full "$stage/portal.py"
intranet_picker_markers_are_full "$stage/Caddyfile.proxy.example"

portal_profile="$work/portal.profile.py"
proxy_profile="$work/Caddyfile.proxy.profile"
snapshot="$work/Caddyfile.base"
candidate="$work/Caddyfile.candidate"
public_override_snapshot="$work/compose.override.base.yaml"
portal_snapshot="$work/portal.base.py"
readme_snapshot="$work/README.base.md"
nginx_snapshot="$work/nginx.base.conf"
compose_snapshot="$work/compose.base.yaml"

[[ -f $public_caddy && ! -L $public_caddy ]]
[[ -f $public_override && ! -L $public_override ]]
[[ -f $intranet_dir/portal.py && ! -L $intranet_dir/portal.py ]]
[[ -f $intranet_dir/README.md && ! -L $intranet_dir/README.md ]]
[[ -f $intranet_dir/nginx.conf && ! -L $intranet_dir/nginx.conf ]]
[[ -f $intranet_dir/compose.yaml && ! -L $intranet_dir/compose.yaml ]]
[[ -f $intranet_dir/secrets/password.hash && ! -L $intranet_dir/secrets/password.hash ]]
cp "$public_caddy" "$snapshot"
cp "$public_override" "$public_override_snapshot"
cp "$intranet_dir/portal.py" "$portal_snapshot"
cp "$intranet_dir/README.md" "$readme_snapshot"
cp "$intranet_dir/nginx.conf" "$nginx_snapshot"
cp "$intranet_dir/compose.yaml" "$compose_snapshot"
if ! cmp -s "$stage/nginx.conf" "$nginx_snapshot"; then
  [[ $(sha256sum "$nginx_snapshot" | awk '{print $1}') == \
    "$legacy_nginx_digest" ]]
fi
if ! cmp -s "$stage/compose.yaml" "$compose_snapshot"; then
  [[ $(sha256sum "$compose_snapshot" | awk '{print $1}') == \
    "$legacy_compose_digest" ]]
fi

cat > "$work/compose.override.expected.yaml" <<'EOF'
services:
  caddy:
    networks:
      default: {}
      intranet_edge: {}
      ab_test_private: {}
      classroom_picker_private: {}

networks:
  intranet_edge:
    external: true
    name: ximarketing_intranet_edge
  ab_test_private:
    external: true
    name: ximarketing_ab_test_private
  classroom_picker_private:
    external: true
    name: ximarketing_classroom_picker_private
EOF
cmp -s "$work/compose.override.expected.yaml" "$stage/compose.proxy.override.yaml" || {
  echo "The staged public Compose override does not include both dedicated private networks." >&2
  exit 1
}

if ! cmp -s "$stage/compose.proxy.override.yaml" "$public_override_snapshot"; then
  cat > "$work/compose.override.legacy-base.yaml" <<'EOF'
services:
  caddy:
    networks:
      default: {}
      intranet_edge: {}

networks:
  intranet_edge:
    external: true
    name: ximarketing_intranet_edge
EOF
  cat > "$work/compose.override.legacy-ab.yaml" <<'EOF'
services:
  caddy:
    networks:
      default: {}
      intranet_edge: {}
      ab_test_private: {}

networks:
  intranet_edge:
    external: true
    name: ximarketing_intranet_edge
  ab_test_private:
    external: true
    name: ximarketing_ab_test_private
EOF
  if ! cmp -s "$work/compose.override.legacy-base.yaml" "$public_override_snapshot" && \
     ! cmp -s "$work/compose.override.legacy-ab.yaml" "$public_override_snapshot"; then
    echo "The public Compose override has unmanaged changes." >&2
    exit 1
  fi
fi

[[ $(docker inspect -f '{{.State.Running}}' "$caddy_container") == true ]]
[[ $(docker inspect -f '{{.State.Health.Status}}' "$portal_container") == healthy ]]
[[ $(docker inspect -f '{{.State.Health.Status}}' "$gateway_container") == healthy ]]
[[ $(docker inspect -f '{{.State.Running}}' "$negotiation_container") == true ]]
