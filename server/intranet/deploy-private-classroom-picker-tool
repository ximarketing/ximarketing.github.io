const assert = require("node:assert/strict");
const crypto = require("node:crypto");
const origin = "https://intranet.ximarketing.ai";
const base = "http://classroom-picker:5000";

async function request(path, options = {}) {
  const response = await fetch(base + path, options);
  const body = await response.json().catch(() => ({}));
  return { response, body };
}

(async () => {
  const health = await request("/healthz");
  assert.equal(health.response.status, 200);
  assert.equal(health.body.status, "ok");

  const initial = await request("/api/state");
  assert.equal(initial.response.status, 200);
  assert.equal(Object.hasOwn(initial.body, "participants"), false);

  const blocked = await request("/api/host/claim", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: "{}",
  });
  assert.equal(blocked.response.status, 403);

  const claim = await request("/api/host/claim", {
    method: "POST",
    headers: { "Content-Type": "application/json", Origin: origin },
    body: "{}",
  });
  assert.equal(claim.response.status, 201);
  assert.equal(
    typeof claim.body.capability === "string" &&
      /^[A-Za-z0-9_-]{43}$/.test(claim.body.capability),
    true,
  );
  const capability = claim.body.capability;

  const secondHost = await request("/api/host/claim", {
    method: "POST",
    headers: { "Content-Type": "application/json", Origin: origin },
    body: "{}",
  });
  assert.equal(secondHost.response.status, 409);

  const submitted = await request("/api/submit", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Origin: origin,
      "X-Participant-Id": crypto.randomUUID(),
    },
    body: JSON.stringify({ label: "Deployment Privacy Probe", gameToken: 0 }),
  });
  assert.equal(submitted.response.status, 200);

  const sameName = await request("/api/submit", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Origin: origin,
      "X-Participant-Id": crypto.randomUUID(),
    },
    body: JSON.stringify({ label: "Deployment Privacy Probe", gameToken: 0 }),
  });
  assert.equal(sameName.response.status, 200);
  assert.equal(sameName.body.label, "Deployment Privacy Probe");

  const publicState = await request("/api/state");
  assert.equal(Object.hasOwn(publicState.body, "participants"), false);
  assert.equal(JSON.stringify(publicState.body).includes("Deployment Privacy Probe"), false);

  const hostHeaders = { "X-Host-Capability": capability };
  const hostState = await request("/api/host/state", { headers: hostHeaders });
  assert.equal(hostState.response.status, 200);
  assert.deepEqual(
    hostState.body.participants.map((participant) => participant.label),
    ["Deployment Privacy Probe", "Deployment Privacy Probe (2)"],
  );

  async function hostPost(path, body = {}) {
    return request(path, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Origin: origin,
        "X-Host-Capability": capability,
      },
      body: JSON.stringify(body),
    });
  }
  assert.equal((await hostPost("/api/host/start", { language: "en" })).response.status, 200);
  assert.equal((await hostPost("/api/host/next")).response.status, 200);
  const picked = await hostPost("/api/host/pick");
  assert.equal(picked.response.status, 200);
  assert.equal(picked.body.selected.length, 1);
  assert.equal((await hostPost("/api/host/reset")).response.status, 200);
})().catch((error) => {
