#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Run this updater with sudo." >&2
  exit 1
fi
force=0
if [[ ${1:-} == --force ]]; then
  force=1
  shift
fi
if [[ $# -ne 1 ]]; then
  echo "Usage: sudo $0 --force /path/to/staged-bundle" >&2
  exit 1
fi
if [[ $force -ne 1 ]]; then
  echo "This update restarts the in-memory game and clears active rooms." >&2
  echo "Run it in a maintenance window and pass --force to confirm." >&2
  exit 1
fi

stage=$(readlink -f -- "$1")
intranet_dir=/opt/ximarketing-intranet
game_dir=/opt/ximarketing-games/negotiation-game
public_caddy="$game_dir/Caddyfile"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
backup="$intranet_dir/backups/private-games.$stamp"
candidate="$stage/Caddyfile.candidate"
snapshot="$stage/Caddyfile.base"
new_dist=""
old_dist=""
dist_swapped=0
files_written=0
caddy_written=0
committed=0
transaction_started=0
pre_legacy_status=""
pre_intranet_status=""

required=(
  portal.py
  test_portal.py
  nginx.conf
  Caddyfile.proxy.example
  Caddyfile.negotiation-redirect.example
  README.md
  game-dist/index.cjs
  game-dist/public/index.html
)
for relative in "${required[@]}"; do
  path="$stage/$relative"
  [[ -f $path && ! -L $path ]] || {
    echo "Missing or unsafe staged file: $path" >&2
    exit 1
  }
done
if find "$stage" -type l -print -quit | grep -q .; then
  echo "The staged bundle must not contain symbolic links." >&2
  exit 1
fi
if grep -R -a -E -q \
  'GAME_PIN|x-host-pin|wrong_pin|Enter the start password|Start password|输入启动密码|启动密码' \
  "$stage/game-dist"; then
  echo "The staged game still contains the retired start-PIN flow." >&2
  exit 1
fi
grep -a -q 'x-host-token' "$stage/game-dist/index.cjs" || {
  echo "The staged game is missing the multiplayer host-token check." >&2
  exit 1
}
grep -a -q 'only_host_can_start' "$stage/game-dist/index.cjs" || {
  echo "The staged game is missing the server-side host-only start guard." >&2
  exit 1
}
if grep -a -F -q 'Math.random().toString(36)' "$stage/game-dist/index.cjs"; then
  echo "The staged game still uses a predictable bearer-token generator." >&2
  exit 1
fi
grep -a -q 'randomBytes' "$stage/game-dist/index.cjs" && \
  grep -a -q 'toString("base64url")' "$stage/game-dist/index.cjs" || {
  echo "The staged game is missing the cryptographically secure token generator." >&2
  exit 1
}
grep -R -a -q '/games/negotiation' "$stage/game-dist/public/assets" || {
  echo "The staged game is missing the protected API prefix." >&2
  exit 1
}

mkdir -p /run/lock
exec 7>/run/lock/ximarketing-public-stack.lock
flock -x 7
exec 8>/run/lock/ximarketing-intranet.lock
flock -x 8

rollback() {
  status=$?
  if [[ $committed -eq 1 || $status -eq 0 ]]; then
    return
  fi
  trap - EXIT INT TERM HUP
  if [[ $transaction_started -eq 0 ]]; then
    exit "$status"
  fi
  set +e
  echo "Deployment failed; restoring the previous portal and game." >&2
  rollback_ok=1

  # Restore the previous game bundle before restoring the route that served it.
  if [[ $dist_swapped -eq 1 && -d $old_dist ]]; then
    if [[ -d "$game_dir/dist" ]]; then
      mv "$game_dir/dist" "$backup/dist-failed-$stamp" || rollback_ok=0
    fi
    mv "$old_dist" "$game_dir/dist" || rollback_ok=0
  elif [[ $dist_swapped -eq 1 && -d "$backup/dist" ]]; then
    if [[ -d "$game_dir/dist" ]]; then
      mv "$game_dir/dist" "$backup/dist-failed-$stamp" || rollback_ok=0
    fi
    mv "$backup/dist" "$game_dir/dist" || rollback_ok=0
  elif [[ $dist_swapped -eq 1 && ! -d "$game_dir/dist" ]]; then
    rollback_ok=0
  fi
  if [[ -n $new_dist && -d $new_dist ]]; then
    mv "$new_dist" "$backup/dist-unused-$stamp" || rollback_ok=0
  fi

  if ! docker compose \
    -f "$game_dir/compose.yaml" \
    -f "$game_dir/compose.override.yaml" \
    up -d --build --force-recreate --no-deps negotiation-game \
    >/dev/null 2>&1; then rollback_ok=0; fi
  if ! docker exec negotiation-game-caddy-1 \
    wget -qO- http://negotiation-game:5000/health | grep -q '"ok"'; then
    rollback_ok=0
  fi

  if [[ $caddy_written -eq 1 && -f "$backup/Caddyfile" ]]; then
    if ! cp "$backup/Caddyfile" "$public_caddy"; then rollback_ok=0; fi
    chown ubuntu:ubuntu "$public_caddy" || rollback_ok=0
    chmod 0644 "$public_caddy" || rollback_ok=0
  fi
  if ! docker exec negotiation-game-caddy-1 caddy validate \
    --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
    rollback_ok=0
  fi
  if ! docker exec negotiation-game-caddy-1 caddy reload \
    --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
    rollback_ok=0
  fi

  if [[ $files_written -eq 1 ]]; then
    cp "$backup/portal.py" "$intranet_dir/portal.py" || rollback_ok=0
    chown root:65534 "$intranet_dir/portal.py" || rollback_ok=0
    chmod 0640 "$intranet_dir/portal.py" || rollback_ok=0
    cp "$backup/nginx.conf" "$intranet_dir/nginx.conf" || rollback_ok=0
    chown root:101 "$intranet_dir/nginx.conf" || rollback_ok=0
    chmod 0640 "$intranet_dir/nginx.conf" || rollback_ok=0
    cp "$backup/README.md" "$intranet_dir/README.md" || rollback_ok=0
    chown root:root "$intranet_dir/README.md" || rollback_ok=0
    chmod 0600 "$intranet_dir/README.md" || rollback_ok=0
  fi
  if ! docker compose -f "$intranet_dir/compose.yaml" \
    up -d --force-recreate --wait --wait-timeout 60 >/dev/null 2>&1; then
    rollback_ok=0
  fi
  if [[ $(docker inspect -f '{{.State.Health.Status}}' \
    ximarketing-intranet-portal 2>/dev/null) != healthy ]]; then rollback_ok=0; fi
  if [[ $(docker inspect -f '{{.State.Health.Status}}' \
    ximarketing-intranet-gateway 2>/dev/null) != healthy ]]; then rollback_ok=0; fi

  restored_legacy=$(curl -sS --max-time 12 -o /dev/null -w '%{http_code}' \
    https://negotiation.ximarketing.ai/ 2>/dev/null || true)
  restored_intranet=$(curl -sS --max-time 12 -o /dev/null -w '%{http_code}' \
    https://intranet.ximarketing.ai/ 2>/dev/null || true)
  [[ $restored_legacy == "$pre_legacy_status" ]] || rollback_ok=0
  [[ $restored_intranet == "$pre_intranet_status" ]] || rollback_ok=0

  if [[ $rollback_ok -eq 1 ]]; then
    echo "Rollback verified. Bundle retained at $backup" >&2
  else
    echo "Automatic rollback could not be fully verified." >&2
    echo "Do not remove the recovery bundle at $backup" >&2
  fi
  exit "$status"
}
trap rollback EXIT
trap 'exit 130' HUP INT TERM

[[ $(grep -c '^negotiation\.ximarketing\.ai {$' "$public_caddy") -eq 1 ]]
[[ $(grep -c '^# BEGIN XIMARKETING INTRANET PROXY$' "$public_caddy") -eq 1 ]]
[[ $(grep -c '^# END XIMARKETING INTRANET PROXY$' "$public_caddy") -eq 1 ]]
private_redirect_begins=$(grep -c '^# BEGIN XIMARKETING PRIVATE NEGOTIATION REDIRECT$' "$public_caddy" || true)
private_redirect_ends=$(grep -c '^# END XIMARKETING PRIVATE NEGOTIATION REDIRECT$' "$public_caddy" || true)
[[ $private_redirect_begins -eq $private_redirect_ends ]]
[[ $private_redirect_begins -le 1 ]]
cp "$public_caddy" "$snapshot"
pre_legacy_status=$(curl -sS --max-time 12 -o /dev/null -w '%{http_code}' \
  https://negotiation.ximarketing.ai/)
pre_intranet_status=$(curl -sS --max-time 12 -o /dev/null -w '%{http_code}' \
  https://intranet.ximarketing.ai/)

awk \
  -v redirect="$stage/Caddyfile.negotiation-redirect.example" \
  -v proxy="$stage/Caddyfile.proxy.example" '
BEGIN {
  while ((getline replacement < redirect) > 0) print replacement
  close(redirect)
}
/^# BEGIN XIMARKETING PRIVATE NEGOTIATION REDIRECT$/ {
  skipping_private_redirect=1
  next
}
skipping_private_redirect {
  if ($0 == "# END XIMARKETING PRIVATE NEGOTIATION REDIRECT") {
    skipping_private_redirect=0
  }
  next
}
/^negotiation\.ximarketing\.ai \{$/ {
  skipping_game=1
  depth=1
  next
}
skipping_game {
  opens=gsub(/\{/, "{")
  closes=gsub(/\}/, "}")
  depth += opens - closes
  if (depth == 0) skipping_game=0
  next
}
/^# BEGIN XIMARKETING INTRANET PROXY$/ {
  while ((getline replacement < proxy) > 0) print replacement
  close(proxy)
  skipping_intranet=1
  next
}
skipping_intranet {
  if ($0 == "# END XIMARKETING INTRANET PROXY") skipping_intranet=0
  next
}
{ print }
END {
  if (skipping_private_redirect || skipping_game || skipping_intranet) exit 42
}
' "$snapshot" > "$candidate"

[[ $(grep -c '^# BEGIN XIMARKETING PRIVATE NEGOTIATION REDIRECT$' "$candidate") -eq 1 ]]
[[ $(grep -c '^# BEGIN XIMARKETING INTRANET PROXY$' "$candidate") -eq 1 ]]
[[ $(grep -c '^chat\.ximarketing\.ai {$' "$candidate") -eq 1 ]]

docker exec -i negotiation-game-caddy-1 caddy validate \
  --config /dev/stdin --adapter caddyfile < "$candidate" >/dev/null
docker run --rm \
  -v "$stage/nginx.conf:/etc/nginx/nginx.conf:ro" \
  nginx:1.30.4-alpine3.24@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46 \
  nginx -t >/dev/null
docker run --rm \
  -e PYTHONDONTWRITEBYTECODE=1 \
  -v "$stage:/app:ro" -w /app \
  python:3.10-alpine@sha256:9110cde5ff2ec1b96a66e7140230bfac3ae16f46305dc17c272bf991757b7ed5 \
  python -m unittest -q test_portal.py

install -d -o root -g root -m 0700 "$backup"
cp -a "$public_caddy" "$backup/Caddyfile"
cp -a "$intranet_dir/portal.py" "$backup/portal.py"
cp -a "$intranet_dir/nginx.conf" "$backup/nginx.conf"
cp -a "$intranet_dir/README.md" "$backup/README.md"
cp -a "$game_dir/compose.yaml" "$backup/game-compose.yaml"
cp -a "$game_dir/compose.override.yaml" "$backup/game-compose.override.yaml"

new_dist=$(mktemp -d "$game_dir/dist.private.XXXXXX")
cp -a "$stage/game-dist/." "$new_dist/"
chown -R root:root "$new_dist"
find "$new_dist" -type d -exec chmod 0755 {} +
find "$new_dist" -type f -exec chmod 0644 {} +

transaction_started=1
files_written=1
install -o root -g 65534 -m 0640 "$stage/portal.py" "$intranet_dir/portal.py"
install -o root -g 101 -m 0640 "$stage/nginx.conf" "$intranet_dir/nginx.conf"
install -o root -g root -m 0600 "$stage/README.md" "$intranet_dir/README.md"
old_dist="$game_dir/dist.before-private-$stamp"
dist_swapped=1
mv "$game_dir/dist" "$old_dist"
mv "$new_dist" "$game_dir/dist"

echo "Rebuilding the game application..."
docker compose \
  -f "$game_dir/compose.yaml" \
  -f "$game_dir/compose.override.yaml" \
  up -d --build --force-recreate --no-deps negotiation-game
echo "Restarting the intranet portal and gateway..."
docker compose -f "$intranet_dir/compose.yaml" \
  up -d --force-recreate --wait --wait-timeout 60

[[ $(docker inspect -f '{{.State.Health.Status}}' ximarketing-intranet-portal) == healthy ]]
[[ $(docker inspect -f '{{.State.Health.Status}}' ximarketing-intranet-gateway) == healthy ]]
[[ -z $(docker port negotiation-game-negotiation-game-1) ]]
docker exec negotiation-game-caddy-1 \
  wget -qO- http://negotiation-game:5000/health | grep -q '"ok"'
docker exec negotiation-game-caddy-1 \
  wget -qO- http://negotiation-game:5000/ | grep -q 'AI Negotiation Arena'
docker exec negotiation-game-negotiation-game-1 sh -c \
  "grep -q '/games/negotiation' /app/dist/public/assets/*.js"

cmp -s "$public_caddy" "$snapshot" || {
  echo "The public Caddyfile changed during deployment; refusing cutover." >&2
  exit 1
}
caddy_written=1
cp "$candidate" "$public_caddy"
chown ubuntu:ubuntu "$public_caddy"
chmod 0644 "$public_caddy"
docker exec negotiation-game-caddy-1 caddy validate \
  --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null
docker exec negotiation-game-caddy-1 caddy reload \
  --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null

echo "Running public no-credential security checks..."
headers="$stage/response.headers"
body="$stage/response.body"

probe() {
  label=$1
  url=$2
  expected=$3
  shift 3
  status=$(curl -sS --max-time 12 "$@" -D "$headers" -o "$body" \
    -w '%{http_code}' "$url")
  location=$(sed -n 's/^[Ll]ocation: \(.*\)\r$/\1/p' "$headers" | tail -1)
  printf '%s status=%s location=%s\n' "$label" "$status" "${location:--}"
  [[ $status == "$expected" ]]
}

probe protected_page https://intranet.ximarketing.ai/games/negotiation/ 303
[[ $location == /login ]]
! grep -q 'AI Negotiation Arena' "$body"

asset=$(basename "$(find "$game_dir/dist/public/assets" -maxdepth 1 \
  -type f -name 'index-*.js' | head -1)")
probe protected_asset \
  "https://intranet.ximarketing.ai/games/negotiation/assets/$asset" 401

probe rejected_write \
  https://intranet.ximarketing.ai/games/negotiation/api/rooms 403 \
  -X POST
probe authenticated_origin_required \
  https://intranet.ximarketing.ai/games/negotiation/api/rooms 401 \
  -X POST -H 'Origin: https://intranet.ximarketing.ai'

probe legacy_root https://negotiation.ximarketing.ai/ 302
[[ $location == https://intranet.ximarketing.ai/games/negotiation/ ]]
for legacy in /api /api/rooms /health /health/check; do
  probe "legacy_${legacy//\//_}" "https://negotiation.ximarketing.ai$legacy" 404
done

probe login_page https://intranet.ximarketing.ai/ 200
[[ $(grep -o 'type="password"' "$body" | wc -l) -eq 1 ]]
! grep -q 'name="username"' "$body"
! grep -q 'Negotiation Games' "$body"

committed=1
trap - EXIT INT TERM HUP
if ! mv "$old_dist" "$backup/dist"; then
  echo "Deployment succeeded, but the prior dist remains at $old_dist" >&2
fi
printf 'DEPLOYED\nBACKUP=%s\n' "$backup"
