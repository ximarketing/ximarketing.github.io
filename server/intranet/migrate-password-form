#!/usr/bin/env bash
set -Eeuo pipefail

readonly MAIN_CADDY_CONTAINER="negotiation-game-caddy-1"
readonly MAIN_CADDYFILE="/opt/ximarketing-games/negotiation-game/Caddyfile"
readonly PUBLIC_COMPOSE_DIR="/opt/ximarketing-games/negotiation-game"
readonly PUBLIC_OVERRIDE="${PUBLIC_COMPOSE_DIR}/compose.override.yaml"
readonly INSTALL_DIR="/opt/ximarketing-intranet"
readonly BACKUP_ROOT="${INSTALL_DIR}/backups"
readonly OLD_CADDYFILE="${INSTALL_DIR}/Caddyfile"
readonly COMPOSEFILE="${INSTALL_DIR}/compose.yaml"
readonly PASSWORD_DIR="${INSTALL_DIR}/secrets"
readonly PASSWORD_HASH_FILE="${PASSWORD_DIR}/password.hash"
readonly RECOVERY_NOTE="${INSTALL_DIR}/INTRANET-RECOVERY.txt"
readonly SYSTEM_RECOVERY_NOTE="/etc/ximarketing-intranet-recovery.txt"
readonly OLD_NETWORK="ximarketing_intranet_proxy"
readonly EDGE_NETWORK="ximarketing_intranet_edge"
readonly APP_NETWORK="ximarketing_intranet_app"
readonly AB_NETWORK="ximarketing_ab_test_private"
readonly AB_CONTAINER="ximarketing-ab-test-showdown"
readonly PORTAL_CONTAINER="ximarketing-intranet-portal"
readonly GATEWAY_CONTAINER="ximarketing-intranet-gateway"
readonly SOURCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ ${EUID} -ne 0 ]]; then
  echo "Run this migration with sudo." >&2
  exit 1
fi

exec 9>/run/lock/ximarketing-intranet.lock
if ! flock -n 9; then
  echo "Another intranet update is already running. Try again in a moment." >&2
  exit 1
fi
exec 7>/run/lock/ximarketing-public-stack.lock
if ! flock -n 7; then
  echo "The public web proxy is being updated. Try again in a moment." >&2
  exit 1
fi

for source_file in \
  Caddyfile.proxy.example compose.yaml compose.proxy.override.yaml nginx.conf \
  portal.py reset-intranet-password README.md intranet-feature-profile.sh; do
  if [[ ! -f ${SOURCE_DIR}/${source_file} ]]; then
    echo "Missing migration file: ${source_file}" >&2
    exit 1
  fi
done
source "${SOURCE_DIR}/intranet-feature-profile.sh"

password_portal_is_canonical() {
  local installed_proxy source_proxy profile ab_members
  [[ -f ${MAIN_CADDYFILE} && -f ${PASSWORD_HASH_FILE} && \
     -f ${INSTALL_DIR}/portal.py && -f ${INSTALL_DIR}/nginx.conf && \
     -f ${COMPOSEFILE} && -f ${INSTALL_DIR}/README.md && \
     -f /usr/local/sbin/reset-intranet-password && -f ${RECOVERY_NOTE} && \
     -f ${SYSTEM_RECOVERY_NOTE} && -f ${PUBLIC_OVERRIDE} ]] || return 1
  grep -Eq '^\$2[aby]\$12\$[./A-Za-z0-9]{53}$' "${PASSWORD_HASH_FILE}" || return 1
  [[ $(stat -c '%u:%g %a' "${PASSWORD_HASH_FILE}") == "0:65534 640" ]] || return 1
  [[ $(stat -c '%u:%g %a' "${INSTALL_DIR}/portal.py") == "0:65534 640" ]] || return 1
  [[ $(stat -c '%u:%g %a' "${INSTALL_DIR}/nginx.conf") == "0:101 640" ]] || return 1
  [[ $(stat -c '%u:%g %a' "${COMPOSEFILE}") == "0:0 600" ]] || return 1
  [[ $(stat -c '%u:%g %a' /usr/local/sbin/reset-intranet-password) == "0:0 700" ]] || return 1
  [[ $(stat -c '%u:%g %a' "${RECOVERY_NOTE}") == "0:0 600" ]] || return 1
  [[ $(stat -c '%u:%g %a' "${SYSTEM_RECOVERY_NOTE}") == "0:0 644" ]] || return 1
  if intranet_ab_markers_are_full "${INSTALL_DIR}/portal.py"; then
    profile=full
  elif intranet_ab_markers_are_absent "${INSTALL_DIR}/portal.py"; then
    profile=base
  else
    return 1
  fi
  cmp -s <(render_intranet_feature_file "$profile" \
    "${SOURCE_DIR}/portal.py" /dev/stdout) "${INSTALL_DIR}/portal.py" || return 1
  cmp -s "${SOURCE_DIR}/nginx.conf" "${INSTALL_DIR}/nginx.conf" || return 1
  cmp -s "${SOURCE_DIR}/compose.yaml" "${COMPOSEFILE}" || return 1
  cmp -s "${SOURCE_DIR}/compose.proxy.override.yaml" "${PUBLIC_OVERRIDE}" || return 1
  [[ $(grep -cF '# BEGIN XIMARKETING INTRANET PROXY' "${MAIN_CADDYFILE}" || true) -eq 1 ]] || return 1
  [[ $(grep -cF '# END XIMARKETING INTRANET PROXY' "${MAIN_CADDYFILE}" || true) -eq 1 ]] || return 1
  installed_proxy="$(sed -n '/# BEGIN XIMARKETING INTRANET PROXY/,/# END XIMARKETING INTRANET PROXY/p' \
    "${MAIN_CADDYFILE}")"
  source_proxy="$(render_intranet_feature_file "$profile" \
    "${SOURCE_DIR}/Caddyfile.proxy.example" /dev/stdout)" || return 1
  [[ ${installed_proxy} == "${source_proxy}" ]] || return 1
  docker compose -f "${COMPOSEFILE}" config --quiet >/dev/null 2>&1 || return 1
  [[ $(docker network inspect --format '{{ .Driver }} {{ .Internal }}' \
       "${EDGE_NETWORK}" 2>/dev/null) == "bridge true" ]] || return 1
  [[ $(docker network inspect --format '{{ .Driver }} {{ .Internal }}' \
       "${APP_NETWORK}" 2>/dev/null) == "bridge true" ]] || return 1
  [[ $(docker network inspect --format '{{ .Driver }} {{ .Internal }}' \
       "${AB_NETWORK}" 2>/dev/null) == "bridge true" ]] || return 1
  edge_members="$(docker network inspect --format \
    '{{ range .Containers }}{{ println .Name }}{{ end }}' "${EDGE_NETWORK}" 2>/dev/null | \
    sed '/^$/d' | sort)" || return 1
  app_members="$(docker network inspect --format \
    '{{ range .Containers }}{{ println .Name }}{{ end }}' "${APP_NETWORK}" 2>/dev/null | \
    sed '/^$/d' | sort)" || return 1
  [[ ${edge_members} == "$(printf '%s\n' "${MAIN_CADDY_CONTAINER}" \
    "${GATEWAY_CONTAINER}" | sort)" ]] || return 1
  [[ ${app_members} == "$(printf '%s\n' "${GATEWAY_CONTAINER}" \
    "${PORTAL_CONTAINER}" | sort)" ]] || return 1
  ab_members="$(docker network inspect --format \
    '{{ range .Containers }}{{ println .Name }}{{ end }}' "${AB_NETWORK}" 2>/dev/null | \
    sed '/^$/d' | sort)" || return 1
  if [[ $profile == full ]]; then
    [[ ${ab_members} == "$(printf '%s\n' "${MAIN_CADDY_CONTAINER}" \
      "${AB_CONTAINER}" | sort)" ]] || return 1
    [[ $(docker inspect --format '{{ if .State.Health }}{{ .State.Health.Status }}{{ end }}' \
      "${AB_CONTAINER}" 2>/dev/null) == healthy ]] || return 1
  else
    [[ ${ab_members} == "${MAIN_CADDY_CONTAINER}" ]] || return 1
    ! docker container inspect "${AB_CONTAINER}" >/dev/null 2>&1 || return 1
  fi
  [[ $(docker inspect --format '{{ if .State.Health }}{{ .State.Health.Status }}{{ end }}' \
       "${PORTAL_CONTAINER}" 2>/dev/null) == healthy ]] || return 1
  [[ $(docker inspect --format '{{ if .State.Health }}{{ .State.Health.Status }}{{ end }}' \
       "${GATEWAY_CONTAINER}" 2>/dev/null) == healthy ]] || return 1
  [[ $(docker exec "${PORTAL_CONTAINER}" python --version 2>&1) == "Python 3.10.21" ]] || return 1
  [[ $(docker exec "${GATEWAY_CONTAINER}" nginx -v 2>&1) == \
     "nginx version: nginx/1.30.4" ]] || return 1
  canonical_page="$(curl -fsS --max-time 10 https://intranet.ximarketing.ai/)" || return 1
  [[ ${canonical_page} == *'name="password"'* && \
     ${canonical_page} != *'name="username"'* ]] || return 1
}

if password_portal_is_canonical; then
  install -o root -g root -m 0700 \
    "${SOURCE_DIR}/reset-intranet-password" /usr/local/sbin/reset-intranet-password
  install -o root -g root -m 0600 "${SOURCE_DIR}/README.md" "${INSTALL_DIR}/README.md"
  echo "The password-only intranet portal is already installed."
  exit 0
fi

for installed_file in \
  "${MAIN_CADDYFILE}" "${PUBLIC_OVERRIDE}" "${OLD_CADDYFILE}" \
  "${COMPOSEFILE}" "${INSTALL_DIR}/nginx.conf" \
  /usr/local/sbin/reset-intranet-password; do
  if [[ ! -f ${installed_file} ]]; then
    echo "The existing intranet installation is incomplete: ${installed_file}" >&2
    exit 1
  fi
done

if ! grep -qF "intranet.ximarketing.ai" "${MAIN_CADDYFILE}"; then
  echo "The public intranet proxy block was not found." >&2
  exit 1
fi

mounted_caddyfile="$(docker inspect --format \
  '{{ range .Mounts }}{{ if eq .Destination "/etc/caddy/Caddyfile" }}{{ .Source }}{{ end }}{{ end }}' \
  "${MAIN_CADDY_CONTAINER}")"
if [[ ${mounted_caddyfile} != "${MAIN_CADDYFILE}" ]]; then
  echo "The expected public Caddyfile is not mounted in Caddy." >&2
  exit 1
fi

legacy_override_expected=$'services:\n  caddy:\n    networks:\n      default: {}\n      intranet_proxy: {}\n\nnetworks:\n  intranet_proxy:\n    external: true\n    name: ximarketing_intranet_proxy'
if [[ $(<"${PUBLIC_OVERRIDE}") != "${legacy_override_expected}" ]]; then
  echo "The public Compose override contains unmanaged changes; manual merging is required." >&2
  exit 1
fi

network_members() {
  local network=$1
  docker network inspect --format '{{ range .Containers }}{{ println .Name }}{{ end }}' \
    "${network}" 2>/dev/null | sed '/^$/d' | sort
}

network_members_are() {
  local network=$1
  shift
  local expected actual
  expected="$(printf '%s\n' "$@" | sed '/^$/d' | sort)"
  actual="$(network_members "${network}")"
  [[ ${actual} == "${expected}" ]]
}

for network in "${EDGE_NETWORK}" "${APP_NETWORK}" "${AB_NETWORK}"; do
  if docker network inspect "${network}" >/dev/null 2>&1; then
    if [[ $(docker network inspect --format '{{ .Driver }} {{ .Internal }}' "${network}") != \
          "bridge true" ]]; then
      echo "The existing Docker network ${network} is not a private bridge." >&2
      exit 1
    fi
    existing_members="$(network_members "${network}")"
    if [[ ${network} == "${EDGE_NETWORK}" ]]; then
      if [[ -n ${existing_members} && ${existing_members} != "${MAIN_CADDY_CONTAINER}" ]]; then
        echo "The existing edge network contains an unexpected container." >&2
        exit 1
      fi
    elif [[ ${network} == "${AB_NETWORK}" ]]; then
      if [[ -n ${existing_members} && ${existing_members} != "${MAIN_CADDY_CONTAINER}" ]]; then
        echo "The existing A/B network contains an unexpected container." >&2
        exit 1
      fi
    elif [[ -n ${existing_members} ]]; then
      echo "The existing application network contains an unexpected container." >&2
      exit 1
    fi
  fi
done

docker compose -f "${PUBLIC_COMPOSE_DIR}/compose.yaml" \
  -f "${SOURCE_DIR}/compose.proxy.override.yaml" config --quiet
docker compose -f "${SOURCE_DIR}/compose.yaml" config --quiet

umask 077
install -d -o root -g root -m 0700 "${BACKUP_ROOT}"
backup_dir="$(mktemp -d "${BACKUP_ROOT}/password-form.XXXXXX")"
public_candidate="$(mktemp "${INSTALL_DIR}/.Caddyfile.public.XXXXXX")"
password_candidate="$(mktemp "${INSTALL_DIR}/.password-hash.XXXXXX")"
portal_profile="$(mktemp "${INSTALL_DIR}/.portal.base.XXXXXX")"
proxy_profile="$(mktemp "${INSTALL_DIR}/.proxy.base.XXXXXX")"
render_intranet_feature_profile base \
  "${SOURCE_DIR}/portal.py" "${SOURCE_DIR}/Caddyfile.proxy.example" \
  "${portal_profile}" "${proxy_profile}"
intranet_ab_markers_are_absent "${portal_profile}"
intranet_ab_markers_are_absent "${proxy_profile}"
transaction_started=0
migration_complete=0
edge_created=0
app_created=0
ab_created=0
main_edge_connected=0
main_ab_connected=0
password_installed=0
public_write_started=0
public_write_completed=0
recovery_note_existed=0
system_recovery_note_existed=0

backup_file() {
  local source=$1
  local name=$2
  install -o root -g root -m 0600 "${source}" "${backup_dir}/${name}"
}

restore_file() {
  local name=$1
  local destination=$2
  if [[ -f ${backup_dir}/${name} ]]; then
    cp -- "${backup_dir}/${name}" "${destination}"
  fi
}

network_has_container() {
  local network=$1
  local container=$2
  docker network inspect --format '{{ range .Containers }}{{ println .Name }}{{ end }}' \
    "${network}" 2>/dev/null | grep -qx "${container}"
}

cleanup() {
  trap - EXIT HUP INT TERM
  if [[ ${transaction_started:-0} -eq 1 && ${migration_complete:-0} -eq 0 ]]; then
    echo "Migration did not complete; restoring the password prompt." >&2
    rollback_ok=1
    if [[ ${public_write_started:-0} -eq 1 ]]; then
      if [[ ${public_write_completed:-0} -eq 0 ]] || \
         cmp -s "${public_candidate}" "${MAIN_CADDYFILE}"; then
        if ! restore_file public-caddy "${MAIN_CADDYFILE}"; then
          rollback_ok=0
        fi
      elif ! cmp -s "${backup_dir}/public-caddy" "${MAIN_CADDYFILE}"; then
        rollback_ok=0
      fi
    fi
    if ! cmp -s "${SOURCE_DIR}/compose.proxy.override.yaml" "${PUBLIC_OVERRIDE}"; then
      rollback_ok=0
    fi
    if [[ ${rollback_ok} -eq 1 ]]; then
      for restore_spec in \
        "public-override:${PUBLIC_OVERRIDE}" \
        "compose:${COMPOSEFILE}" \
        "nginx:${INSTALL_DIR}/nginx.conf" \
        "reset-tool:/usr/local/sbin/reset-intranet-password" \
        "readme:${INSTALL_DIR}/README.md" \
        "private-caddy:${OLD_CADDYFILE}"; do
        restore_name="${restore_spec%%:*}"
        restore_destination="${restore_spec#*:}"
        if ! restore_file "${restore_name}" "${restore_destination}"; then
          rollback_ok=0
        fi
      done
      if [[ ${recovery_note_existed:-0} -eq 1 ]]; then
        if ! restore_file recovery-note "${RECOVERY_NOTE}"; then
          rollback_ok=0
        fi
      else
        rm -f -- "${RECOVERY_NOTE}" || rollback_ok=0
      fi
      if [[ ${system_recovery_note_existed:-0} -eq 1 ]]; then
        if ! restore_file system-recovery-note "${SYSTEM_RECOVERY_NOTE}"; then
          rollback_ok=0
        fi
      else
        rm -f -- "${SYSTEM_RECOVERY_NOTE}" || rollback_ok=0
      fi
      chmod 0700 /usr/local/sbin/reset-intranet-password 2>/dev/null || rollback_ok=0
      chmod 0600 "${INSTALL_DIR}/README.md" 2>/dev/null || rollback_ok=0
      chown root:65534 "${OLD_CADDYFILE}" 2>/dev/null || rollback_ok=0
      chmod 0640 "${OLD_CADDYFILE}" 2>/dev/null || rollback_ok=0
    fi

    if [[ ${rollback_ok} -eq 1 ]] && \
       ! docker network inspect "${OLD_NETWORK}" >/dev/null 2>&1; then
      docker network create --driver bridge --internal "${OLD_NETWORK}" \
        >/dev/null 2>&1 || rollback_ok=0
    fi
    if [[ ${rollback_ok} -eq 1 ]] && \
       ! network_has_container "${OLD_NETWORK}" "${MAIN_CADDY_CONTAINER}"; then
      docker network connect "${OLD_NETWORK}" "${MAIN_CADDY_CONTAINER}" \
        >/dev/null 2>&1 || rollback_ok=0
    fi
    if [[ ${rollback_ok} -eq 1 ]] && ! docker compose -f "${COMPOSEFILE}" \
      up -d --force-recreate --remove-orphans --wait --wait-timeout 60 \
      >/dev/null 2>&1; then
      rollback_ok=0
    fi
    if [[ ${rollback_ok} -eq 1 ]] && ! docker exec "${MAIN_CADDY_CONTAINER}" \
      caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile \
      >/dev/null 2>&1; then
      rollback_ok=0
    fi
    if [[ ${rollback_ok} -eq 1 ]] && ! docker exec "${MAIN_CADDY_CONTAINER}" \
      caddy reload --force --config /etc/caddy/Caddyfile --adapter caddyfile \
      >/dev/null 2>&1; then
      rollback_ok=0
    fi
    rollback_probe=""
    if [[ ${rollback_ok} -eq 1 ]]; then
      rollback_probe="$(docker exec "${MAIN_CADDY_CONTAINER}" \
        wget -q --header='X-Real-IP: 127.0.0.1' -S -O /dev/null \
        http://ximarketing-intranet-gateway:8080/ 2>&1 || true)"
      if [[ ${rollback_probe} != *" 401 "* ]]; then
        rollback_ok=0
      fi
    fi

    if [[ ${rollback_ok} -eq 1 ]]; then
      if [[ ${main_edge_connected:-0} -eq 1 ]]; then
        docker network disconnect "${EDGE_NETWORK}" "${MAIN_CADDY_CONTAINER}" \
          >/dev/null 2>&1 || true
      fi
      if [[ ${main_ab_connected:-0} -eq 1 ]]; then
        docker network disconnect "${AB_NETWORK}" "${MAIN_CADDY_CONTAINER}" \
          >/dev/null 2>&1 || true
      fi
      if [[ ${app_created:-0} -eq 1 ]]; then
        docker network rm "${APP_NETWORK}" >/dev/null 2>&1 || true
      fi
      if [[ ${edge_created:-0} -eq 1 ]]; then
        docker network rm "${EDGE_NETWORK}" >/dev/null 2>&1 || true
      fi
      if [[ ${ab_created:-0} -eq 1 ]]; then
        docker network rm "${AB_NETWORK}" >/dev/null 2>&1 || true
      fi
      if [[ ${password_installed:-0} -eq 1 ]]; then
        rm -f -- "${PASSWORD_HASH_FILE}"
      fi
      rm -f -- "${INSTALL_DIR}/portal.py"
      rm -f -- \
        "${backup_dir}/public-caddy" "${backup_dir}/public-override" \
        "${backup_dir}/compose" "${backup_dir}/nginx" \
        "${backup_dir}/reset-tool" "${backup_dir}/readme" \
        "${backup_dir}/private-caddy" "${backup_dir}/recovery-note" \
        "${backup_dir}/system-recovery-note"
      rmdir "${backup_dir}" 2>/dev/null || true
      echo "The original password prompt was restored." >&2
    else
      echo "Automatic rollback could not be verified. New services and recovery files were left in place." >&2
      echo "Manual recovery files are retained at ${backup_dir}" >&2
    fi
    backup_dir=""
  fi
  rm -f -- "${public_candidate:-}" "${password_candidate:-}" \
    "${portal_profile:-}" "${proxy_profile:-}"
  if [[ -n ${backup_dir:-} && -d ${backup_dir} && \
        ${transaction_started:-0} -eq 0 ]]; then
    rm -f -- \
      "${backup_dir}/public-caddy" "${backup_dir}/public-override" \
      "${backup_dir}/compose" "${backup_dir}/nginx" \
      "${backup_dir}/reset-tool" "${backup_dir}/readme" \
      "${backup_dir}/private-caddy" "${backup_dir}/recovery-note" \
      "${backup_dir}/system-recovery-note" "${backup_dir}/ROLLBACK-INSTRUCTIONS.txt"
    rmdir "${backup_dir}" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

backup_file "${MAIN_CADDYFILE}" public-caddy
backup_file "${PUBLIC_OVERRIDE}" public-override
backup_file "${COMPOSEFILE}" compose
backup_file "${INSTALL_DIR}/nginx.conf" nginx
backup_file /usr/local/sbin/reset-intranet-password reset-tool
backup_file "${INSTALL_DIR}/README.md" readme
backup_file "${OLD_CADDYFILE}" private-caddy
if [[ -f ${RECOVERY_NOTE} ]]; then
  recovery_note_existed=1
  backup_file "${RECOVERY_NOTE}" recovery-note
fi
if [[ -f ${SYSTEM_RECOVERY_NOTE} ]]; then
  system_recovery_note_existed=1
  backup_file "${SYSTEM_RECOVERY_NOTE}" system-recovery-note
fi

if ! awk '
  /# BEGIN XIMARKETING INTRANET AUTH/ { inside = 1; begins += 1; next }
  /# END XIMARKETING INTRANET AUTH/ { inside = 0; ends += 1; next }
  inside && $1 == "member" && $2 ~ /^\$2[aby]\$12\$[.\/A-Za-z0-9]{53}$/ {
    print $2
    found += 1
  }
  END { if (inside || begins != 1 || ends != 1 || found != 1) exit 42 }
' "${OLD_CADDYFILE}" > "${password_candidate}"; then
  echo "Could not extract the existing password hash. Nothing was changed." >&2
  exit 1
fi

if ! awk -v block="${proxy_profile}" '
  function brace_delta(value, copy, opens, closes) {
    copy = value
    opens = gsub(/\{/, "", copy)
    copy = value
    closes = gsub(/\}/, "", copy)
    return opens - closes
  }
  $0 == "intranet.ximarketing.ai {" && !inside {
    inside = 1
    depth = 1
    replaced += 1
    next
  }
  inside {
    depth += brace_delta($0)
    if (depth == 0) {
      while ((getline line < block) > 0) print line
      close(block)
      inside = 0
    }
    next
  }
  { print }
  END {
    if (inside || replaced != 1) exit 43
  }
' "${backup_dir}/public-caddy" > "${public_candidate}"; then
  echo "Could not prepare the password-form proxy block. Nothing was changed." >&2
  exit 1
fi

if ! docker exec -i "${MAIN_CADDY_CONTAINER}" \
  caddy validate --config - --adapter caddyfile < "${public_candidate}" \
  >/dev/null 2>&1; then
  echo "The new public proxy configuration did not validate." >&2
  exit 1
fi

if ! cmp -s "${backup_dir}/public-override" "${PUBLIC_OVERRIDE}"; then
  echo "The public Compose override changed during preparation. Nothing was changed." >&2
  exit 1
fi

transaction_started=1
install -d -o root -g 65534 -m 0750 "${PASSWORD_DIR}"
install -o root -g 65534 -m 0640 "${password_candidate}" "${PASSWORD_HASH_FILE}"
password_installed=1
install -o root -g 65534 -m 0640 "${portal_profile}" "${INSTALL_DIR}/portal.py"
install -o root -g 101 -m 0640 "${SOURCE_DIR}/nginx.conf" "${INSTALL_DIR}/nginx.conf"
install -o root -g root -m 0600 "${SOURCE_DIR}/compose.yaml" "${COMPOSEFILE}"
install -o root -g root -m 0700 \
  "${SOURCE_DIR}/reset-intranet-password" /usr/local/sbin/reset-intranet-password
install -o root -g root -m 0600 "${SOURCE_DIR}/README.md" "${INSTALL_DIR}/README.md"
install -o root -g root -m 0644 \
  "${SOURCE_DIR}/compose.proxy.override.yaml" "${PUBLIC_OVERRIDE}"
printf '%s\n' \
  'Xi Li intranet password recovery' \
  '' \
  'Run this in an interactive Tencent Cloud terminal:' \
  '  sudo reset-intranet-password' \
  '' \
  'The old intranet password is not required.' > "${RECOVERY_NOTE}"
chmod 0600 "${RECOVERY_NOTE}"
install -o root -g root -m 0644 "${RECOVERY_NOTE}" "${SYSTEM_RECOVERY_NOTE}"

if ! docker network inspect "${EDGE_NETWORK}" >/dev/null 2>&1; then
  edge_created=1
  docker network create --driver bridge --internal "${EDGE_NETWORK}" >/dev/null
fi
if ! docker network inspect "${APP_NETWORK}" >/dev/null 2>&1; then
  app_created=1
  docker network create --driver bridge --internal "${APP_NETWORK}" >/dev/null
fi
if ! docker network inspect "${AB_NETWORK}" >/dev/null 2>&1; then
  ab_created=1
  docker network create --driver bridge --internal "${AB_NETWORK}" >/dev/null
fi
for network in "${EDGE_NETWORK}" "${APP_NETWORK}" "${AB_NETWORK}"; do
  if [[ $(docker network inspect --format '{{ .Internal }}' "${network}") != true ]]; then
    echo "The Docker network ${network} is not internal." >&2
    exit 1
  fi
done
if ! network_has_container "${EDGE_NETWORK}" "${MAIN_CADDY_CONTAINER}"; then
  main_edge_connected=1
  docker network connect "${EDGE_NETWORK}" "${MAIN_CADDY_CONTAINER}"
fi
if ! network_has_container "${AB_NETWORK}" "${MAIN_CADDY_CONTAINER}"; then
  main_ab_connected=1
  docker network connect "${AB_NETWORK}" "${MAIN_CADDY_CONTAINER}"
fi

docker compose -f "${PUBLIC_COMPOSE_DIR}/compose.yaml" -f "${PUBLIC_OVERRIDE}" \
  config --quiet
docker compose -f "${COMPOSEFILE}" config --quiet
docker compose -f "${COMPOSEFILE}" pull --quiet
docker compose -f "${COMPOSEFILE}" up -d --force-recreate --remove-orphans \
  --wait --wait-timeout 60 >/dev/null

if [[ $(docker exec "${PORTAL_CONTAINER}" python --version 2>&1) != "Python 3.10.21" ]]; then
  echo "The password portal is not running the pinned Python version." >&2
  exit 1
fi

if ! network_members_are "${EDGE_NETWORK}" \
  "${MAIN_CADDY_CONTAINER}" "${GATEWAY_CONTAINER}" || \
   ! network_members_are "${APP_NETWORK}" \
  "${GATEWAY_CONTAINER}" "${PORTAL_CONTAINER}" || \
   ! network_members_are "${AB_NETWORK}" "${MAIN_CADDY_CONTAINER}"; then
  echo "The private Docker networks contain unexpected containers." >&2
  exit 1
fi
if [[ $(docker exec "${GATEWAY_CONTAINER}" nginx -v 2>&1) != \
      "nginx version: nginx/1.30.4" ]]; then
  echo "The password gateway is not running the pinned nginx version." >&2
  exit 1
fi

gateway_probe="$(docker exec "${MAIN_CADDY_CONTAINER}" \
  wget -q --header='X-Real-IP: 127.0.0.1' -S -O /dev/null \
  http://ximarketing-intranet-gateway:8080/login 2>&1 || true)"
if [[ ${gateway_probe} != *"X-Xi-Intranet-Portal: password-form"* ]]; then
  echo "The password-only gateway did not pass its readiness probe." >&2
  exit 1
fi

exec 8<>"${MAIN_CADDYFILE}"
flock -x 8
if ! cmp -s "${backup_dir}/public-caddy" "${MAIN_CADDYFILE}"; then
  flock -u 8
  echo "The public Caddyfile changed during migration; no proxy change was applied." >&2
  exit 1
fi
public_write_started=1
if ! cp -- "${public_candidate}" "${MAIN_CADDYFILE}"; then
  flock -u 8
  echo "The public proxy configuration could not be installed." >&2
  exit 1
fi
if ! cmp -s "${public_candidate}" "${MAIN_CADDYFILE}"; then
  flock -u 8
  echo "The installed public proxy configuration was incomplete." >&2
  exit 1
fi
public_write_completed=1
flock -u 8
if ! docker exec "${MAIN_CADDY_CONTAINER}" \
  caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
  echo "The installed public proxy configuration was invalid." >&2
  exit 1
fi
if ! docker exec "${MAIN_CADDY_CONTAINER}" \
  caddy reload --force --config /etc/caddy/Caddyfile --adapter caddyfile \
  >/dev/null 2>&1; then
  echo "Public Caddy could not load the password-form portal." >&2
  exit 1
fi

public_page="$(curl -fsS --max-time 10 https://intranet.ximarketing.ai/)"
if [[ ${public_page} != *'name="password"'* || ${public_page} == *'name="username"'* ]]; then
  echo "The public password-only form did not pass its final check." >&2
  exit 1
fi
intranet_ab_markers_are_absent "${INSTALL_DIR}/portal.py"
installed_proxy="$(sed -n '/# BEGIN XIMARKETING INTRANET PROXY/,/# END XIMARKETING INTRANET PROXY/p' \
  "${MAIN_CADDYFILE}")"
[[ ${installed_proxy} == "$(<"${proxy_profile}")" ]]

migration_complete=1
rm -f -- "${OLD_CADDYFILE}"
if network_has_container "${OLD_NETWORK}" "${MAIN_CADDY_CONTAINER}"; then
  docker network disconnect "${OLD_NETWORK}" "${MAIN_CADDY_CONTAINER}" >/dev/null
fi
if docker network inspect "${OLD_NETWORK}" >/dev/null 2>&1 && \
   [[ -z $(docker network inspect --format '{{ range .Containers }}{{ .Name }}{{ end }}' \
       "${OLD_NETWORK}") ]]; then
  docker network rm "${OLD_NETWORK}" >/dev/null
fi

echo "Password-only intranet login installed. The existing password was preserved."
echo "Rollback files are retained until login is confirmed: ${backup_dir}"
