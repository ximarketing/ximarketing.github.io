#!/usr/bin/env bash
set -Eeuo pipefail

readonly HASH_CONTAINER="negotiation-game-caddy-1"
readonly PORTAL_CONTAINER="ximarketing-intranet-portal"
readonly PASSWORD_HASH_FILE="/opt/ximarketing-intranet/secrets/password.hash"
readonly COMPOSEFILE="/opt/ximarketing-intranet/compose.yaml"

if [[ ${EUID} -ne 0 ]]; then
  echo "Run this command with sudo: sudo reset-intranet-password" >&2
  exit 1
fi

exec 9>/run/lock/ximarketing-intranet.lock
if ! flock -n 9; then
  echo "Another intranet update is already running. Try again in a moment." >&2
  exit 1
fi

if [[ ! -f ${PASSWORD_HASH_FILE} || ! -f ${COMPOSEFILE} ]]; then
  echo "The intranet service is not installed." >&2
  exit 1
fi

if [[ ! -t 0 ]]; then
  echo "Run this command in an interactive terminal." >&2
  exit 1
fi

if ! grep -Eq '^\$2[aby]\$12\$[./A-Za-z0-9]{53}$' "${PASSWORD_HASH_FILE}"; then
  echo "The private password file is malformed. Nothing was changed." >&2
  exit 1
fi

if ! docker inspect "${HASH_CONTAINER}" >/dev/null 2>&1; then
  echo "The server password-hashing service is unavailable." >&2
  exit 1
fi

caddy_version="$(docker exec "${HASH_CONTAINER}" caddy version)"
if [[ ${caddy_version} =~ ^v?([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
  caddy_major="${BASH_REMATCH[1]}"
  caddy_minor="${BASH_REMATCH[2]}"
  caddy_patch="${BASH_REMATCH[3]}"
else
  echo "Could not determine the password-hashing service version." >&2
  exit 1
fi
if (( caddy_major < 2 || \
      (caddy_major == 2 && \
       (caddy_minor < 11 || (caddy_minor == 11 && caddy_patch < 4))) )); then
  echo "Caddy 2.11.4 or newer is required to reset the password." >&2
  exit 1
fi

IFS= read -r -s -p "New intranet password (exactly 8 characters): " password_one
printf '\n'
IFS= read -r -s -p "Enter the new password again: " password_two
printf '\n'

if [[ ${#password_one} -ne 8 ]]; then
  unset password_one password_two
  echo "The password must contain exactly 8 characters." >&2
  exit 1
fi

password_bytes="$(LC_ALL=C printf '%s' "${password_one}" | wc -c | tr -d '[:space:]')"
if (( password_bytes > 72 )); then
  unset password_one password_two
  echo "The password must be no longer than 72 bytes." >&2
  exit 1
fi

if [[ ${password_one} != "${password_two}" ]]; then
  unset password_one password_two
  echo "The two passwords did not match. Nothing was changed." >&2
  exit 1
fi

if ! password_hash="$({ printf '%s\n' "${password_one}"; } | \
  docker exec -i "${HASH_CONTAINER}" \
    caddy hash-password --algorithm bcrypt --bcrypt-cost 12 2>/dev/null)"; then
  unset password_one password_two password_hash
  echo "Could not create a secure password hash. Nothing was changed." >&2
  exit 1
fi
unset password_one password_two

if [[ ! ${password_hash} =~ ^\$2[aby]\$12\$[./A-Za-z0-9]{53}$ ]]; then
  unset password_hash
  echo "Could not create a secure password hash. Nothing was changed." >&2
  exit 1
fi

umask 077
candidate=""
backup=""
transaction_started=0
completed=0

portal_health() {
  docker exec "${PORTAL_CONTAINER}" python -c \
    "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3); assert r.status == 204" \
    >/dev/null 2>&1
}

cleanup() {
  trap - EXIT HUP INT TERM
  unset password_one password_two password_hash
  if [[ ${transaction_started:-0} -eq 1 && ${completed:-0} -eq 0 && -f ${backup:-} ]]; then
    rollback="${PASSWORD_HASH_FILE}.rollback.$$"
    if cp -- "${backup}" "${rollback}" && \
       chown root:65534 "${rollback}" && chmod 0640 "${rollback}" && \
       mv -f -- "${rollback}" "${PASSWORD_HASH_FILE}" && portal_health; then
      transaction_started=0
    else
      rm -f -- "${rollback:-}"
      echo "Automatic rollback failed. Recovery backup retained at ${backup}" >&2
      backup=""
    fi
  fi
  rm -f -- "${candidate:-}" "${backup:-}"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

candidate="$(mktemp /opt/ximarketing-intranet/secrets/.password.candidate.XXXXXX)"
backup="$(mktemp /opt/ximarketing-intranet/secrets/.password.backup.XXXXXX)"
printf '%s\n' "${password_hash}" > "${candidate}"
unset password_hash
chown root:65534 "${candidate}"
chmod 0640 "${candidate}"
cp -- "${PASSWORD_HASH_FILE}" "${backup}"

if ! grep -Eq '^\$2[aby]\$12\$[./A-Za-z0-9]{53}$' "${candidate}"; then
  echo "The new password hash was invalid. Nothing was changed." >&2
  exit 1
fi

if ! docker inspect "${PORTAL_CONTAINER}" >/dev/null 2>&1 || \
   [[ $(docker inspect --format '{{ .State.Running }}' "${PORTAL_CONTAINER}" 2>/dev/null) != true ]]; then
  docker compose -f "${COMPOSEFILE}" up -d --wait --wait-timeout 60 >/dev/null
fi

transaction_started=1
mv -f -- "${candidate}" "${PASSWORD_HASH_FILE}"
candidate=""

if ! portal_health; then
  echo "The portal could not read the new password; restoring the previous one." >&2
  exit 1
fi

completed=1
echo "Intranet password updated. Existing login sessions have been revoked."
