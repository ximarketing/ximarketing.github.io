#!/usr/bin/env bash
set -Eeuo pipefail

readonly CADDY_CONTAINER="ximarketing-intranet-auth"
readonly CADDYFILE="/opt/ximarketing-intranet/Caddyfile"
readonly COMPOSEFILE="/opt/ximarketing-intranet/compose.yaml"
readonly AUTH_BEGIN="# BEGIN XIMARKETING INTRANET AUTH"
readonly AUTH_END="# END XIMARKETING INTRANET AUTH"

if [[ ${EUID} -ne 0 ]]; then
  echo "Run this command with sudo: sudo reset-intranet-password" >&2
  exit 1
fi

exec 9>/run/lock/ximarketing-intranet.lock
if ! flock -n 9; then
  echo "Another intranet update is already running. Try again in a moment." >&2
  exit 1
fi

if [[ ! -f ${CADDYFILE} || ! -f ${COMPOSEFILE} ]]; then
  echo "The intranet service is not installed." >&2
  exit 1
fi

if [[ ! -t 0 ]]; then
  echo "Run this command in an interactive terminal." >&2
  exit 1
fi

if ! docker inspect "${CADDY_CONTAINER}" >/dev/null 2>&1 || \
   [[ $(docker inspect --format '{{ .State.Running }}' "${CADDY_CONTAINER}" 2>/dev/null) != true ]]; then
  docker compose -f "${COMPOSEFILE}" up -d --wait --wait-timeout 60 >/dev/null
fi

mounted_caddyfile="$(docker inspect --format \
  '{{ range .Mounts }}{{ if eq .Destination "/etc/caddy/Caddyfile" }}{{ .Source }}{{ end }}{{ end }}' \
  "${CADDY_CONTAINER}")"
if [[ ${mounted_caddyfile} != "${CADDYFILE}" ]]; then
  echo "The expected private Caddyfile is not mounted in the auth container." >&2
  exit 1
fi

if ! awk -v begin="${AUTH_BEGIN}" -v end="${AUTH_END}" '
  {
    normalized = $0
    sub(/^[[:space:]]*/, "", normalized)
  }
  normalized == begin {
    begins += 1
    if (state != 0) bad = 1
    state = 1
    next
  }
  state == 1 && normalized == "basic_auth bcrypt {" {
    state = 2
    next
  }
  state == 2 && $1 == "member" && NF == 2 {
    members += 1
    state = 3
    next
  }
  state == 3 && normalized == "}" {
    state = 4
    next
  }
  normalized == end {
    ends += 1
    if (state != 4) bad = 1
    state = 5
    next
  }
  state >= 1 && state <= 4 {
    bad = 1
  }
  END {
    if (begins != 1 || members != 1 || ends != 1 || state != 5 || bad) exit 1
  }
' "${CADDYFILE}"; then
  echo "The private authentication block is malformed. Nothing was changed." >&2
  exit 1
fi

caddy_version="$(docker exec "${CADDY_CONTAINER}" caddy version)"
if [[ ${caddy_version%% *} != v2.11.4 ]]; then
  echo "The isolated auth container must run Caddy 2.11.4." >&2
  exit 1
fi

IFS= read -r -s -p "New intranet password (exactly 8 characters): " password_one
printf '\n'
IFS= read -r -s -p "Enter the new password again: " password_two
printf '\n'

if [[ ${#password_one} -ne 8 ]]; then
  unset password_one password_two
  echo "The password must contain exactly 8 characters." >&2
  exit 1
fi

password_bytes="$(LC_ALL=C printf '%s' "${password_one}" | wc -c | tr -d '[:space:]')"
if (( password_bytes > 72 )); then
  unset password_one password_two
  echo "The password must be no longer than 72 bytes; use a shorter passphrase." >&2
  exit 1
fi

if [[ ${password_one} != "${password_two}" ]]; then
  unset password_one password_two
  echo "The two passwords did not match. Nothing was changed." >&2
  exit 1
fi

if ! password_hash="$({ printf '%s\n' "${password_one}"; } | \
  docker exec -i "${CADDY_CONTAINER}" \
    caddy hash-password --algorithm bcrypt --bcrypt-cost 12 2>/dev/null)"; then
  unset password_one password_two password_hash
  echo "Could not create a secure password hash. Nothing was changed." >&2
  exit 1
fi
unset password_one password_two

if [[ ${password_hash} != '$2'* ]]; then
  unset password_hash
  echo "Could not create a secure password hash. Nothing was changed." >&2
  exit 1
fi

umask 077
hash_file=""
candidate=""
backup=""
completed=0
transaction_started=0

cleanup() {
  trap - EXIT HUP INT TERM
  unset password_one password_two password_hash
  rm -f -- "${hash_file:-}" "${candidate:-}"
  rollback_succeeded=0
  if [[ ${transaction_started:-0} -eq 1 && ${completed:-0} -eq 0 && -f ${backup:-} ]]; then
    if cp -- "${backup}" "${CADDYFILE}" && \
       chown root:65534 "${CADDYFILE}" && chmod 0640 "${CADDYFILE}" && \
       docker exec "${CADDY_CONTAINER}" \
         caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 && \
       docker exec "${CADDY_CONTAINER}" \
         caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
      rollback_succeeded=1
    fi
  fi

  if [[ ${completed:-0} -eq 1 || ${transaction_started:-0} -eq 0 || ${rollback_succeeded} -eq 1 ]]; then
    rm -f -- "${backup:-}"
  elif [[ -n ${backup:-} && -f ${backup:-} ]]; then
    echo "Automatic rollback failed. Recovery backup retained at ${backup}" >&2
  fi
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

hash_file="$(mktemp /opt/ximarketing-intranet/.password-hash.XXXXXX)"
candidate="$(mktemp /opt/ximarketing-intranet/.Caddyfile.candidate.XXXXXX)"
backup="$(mktemp /opt/ximarketing-intranet/.Caddyfile.backup.XXXXXX)"
printf '%s\n' "${password_hash}" > "${hash_file}"
unset password_hash

cp -- "${CADDYFILE}" "${backup}"

awk -v hash_file="${hash_file}" -v begin="${AUTH_BEGIN}" -v end="${AUTH_END}" '
  BEGIN {
    if ((getline hash < hash_file) != 1) exit 41
    close(hash_file)
  }
  {
    normalized = $0
    sub(/^[[:space:]]*/, "", normalized)
  }
  normalized == begin { inside = 1; print; next }
  normalized == end { inside = 0; print; next }
  inside && $1 == "member" {
    match($0, /^[[:space:]]*/)
    print substr($0, RSTART, RLENGTH) "member " hash
    replaced += 1
    next
  }
  { print }
  END {
    if (replaced != 1) exit 42
  }
' "${CADDYFILE}" > "${candidate}" || {
  echo "The intranet authentication block was not found. Nothing was changed." >&2
  exit 1
}

transaction_started=1
cp -- "${candidate}" "${CADDYFILE}"
chown root:65534 "${CADDYFILE}"
chmod 0640 "${CADDYFILE}"

if ! docker exec "${CADDY_CONTAINER}" \
  caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
  echo "The new configuration was invalid; restoring the previous password." >&2
  exit 1
fi

if ! docker exec "${CADDY_CONTAINER}" \
  caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
  echo "Caddy could not reload; restoring the previous password." >&2
  exit 1
fi

completed=1
echo "Intranet password updated. Username: member"
